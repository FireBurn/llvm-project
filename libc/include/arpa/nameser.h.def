#ifndef _LLVM_LIBC_ARPA_NAMESER_H
#define _LLVM_LIBC_ARPA_NAMESER_H

#include "../__llvm-libc-common.h"

%%public_api()

// glibc's <arpa/nameser.h> ends with the BIND 4 names, and programs that name
// T_A or C_IN rely on it.
#include <arpa/nameser_compat.h>

#endif // _LLVM_LIBC_ARPA_NAMESER_H
