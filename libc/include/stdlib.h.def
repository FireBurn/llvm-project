#ifndef _LLVM_LIBC_STDLIB_H
#define _LLVM_LIBC_STDLIB_H

#include "__llvm-libc-common.h"

%%public_api()

#ifdef __ANDROID__
// bionic's includes <malloc.h>, and Android code calls mallopt without it.
#include <malloc.h>
#endif // __ANDROID__

#endif // _LLVM_LIBC_STDLIB_H
