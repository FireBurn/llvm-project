#ifndef LLVM_LIBC_STDBIT_H
#define LLVM_LIBC_STDBIT_H

#include "__llvm-libc-common.h"

// glibc's <stdbit.h> makes the <stdint.h> types visible and portable code
// written against it, gnulib among others, relies on that.
#include <stdint.h>

%%public_api()

#include "llvm-libc-macros/stdbit-macros.h"

#endif // LLVM_LIBC_STDBIT_H
