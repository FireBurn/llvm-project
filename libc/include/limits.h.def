#ifndef _LLVM_LIBC_LIMITS_H
#define _LLVM_LIBC_LIMITS_H

#include "__llvm-libc-common.h"

%%public_api()

#ifdef __ANDROID__
// bionic exposes the content of <float.h> from <limits.h>, and Android code
// relies on it (FLT_MAX).
#include <float.h>
#endif // __ANDROID__

#endif // _LLVM_LIBC_LIMITS_H
