#ifndef _LLVM_LIBC_NETINET_IGMP_H
#define _LLVM_LIBC_NETINET_IGMP_H

#include "../__llvm-libc-common.h"

%%public_api()

#ifdef __ANDROID__
// bionic's brings in the kernel's IGMP message types and numbers, which
// Android code uses under their kernel names (IGMPV2_HOST_MEMBERSHIP_REPORT).
#include <linux/igmp.h>
#endif // __ANDROID__

#endif // _LLVM_LIBC_NETINET_IGMP_H
