#ifndef _LLVM_LIBC_SYS_XATTR_H
#define _LLVM_LIBC_SYS_XATTR_H

#include "../__llvm-libc-common.h"

%%public_api()

#ifdef __ANDROID__
// bionic's brings in the names of the extended attributes the kernel uses,
// such as XATTR_NAME_SELINUX.
#include <linux/xattr.h>
#endif // __ANDROID__

#endif // _LLVM_LIBC_SYS_XATTR_H
