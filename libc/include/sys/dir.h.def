#ifndef LLVM_LIBC_SYS_DIR_H
#define LLVM_LIBC_SYS_DIR_H

#include "__llvm-libc-common.h"

#include <dirent.h>

// The name the directory entry went by before POSIX settled on dirent, kept
// so that code written against the older interface still reads.
#define direct dirent

%%public_api()

#endif // LLVM_LIBC_SYS_DIR_H
