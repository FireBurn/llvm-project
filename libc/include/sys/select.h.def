#ifndef _LLVM_LIBC_SYS_SELECT_H
#define _LLVM_LIBC_SYS_SELECT_H

#include "../__llvm-libc-common.h"

%%public_api()

#ifdef __ANDROID__
// bionic's includes <signal.h>, and Android code that includes <sys/time.h>
// calls kill without including it.
#include <signal.h>
#endif // __ANDROID__

#endif // _LLVM_LIBC_SYS_SELECT_H
