#ifndef LLVM_LIBC_PTY_H
#define LLVM_LIBC_PTY_H

#include "__llvm-libc-common.h"

// glibc's declares the terminal functions and window size ioctls through
// these, and programs written against it rely on that.
#include <sys/ioctl.h>
#include <termios.h>

%%public_api()

#endif // LLVM_LIBC_PTY_H
