# Tests for LLVM libc arpa/nameser.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "ns_parse_test",
    srcs = ["ns_parse_test.cpp"],
    deps = [
        "//libc:ns_get16",
        "//libc:ns_get32",
        "//libc:ns_name_uncompress",
        "//libc:ns_put16",
        "//libc:ns_put32",
        "//libc:ns_skiprr",
        "//libc:hdr_errno_macros",
        "//libc:ns_initparse",
        "//libc:ns_parserr",
        "//libc:types_ns_msg",
        "//libc:types_ns_rr",
    ],
)

libc_test(
    name = "ns_name_test",
    srcs = ["ns_name_test.cpp"],
    deps = [
        "//libc:hdr_errno_macros",
        "//libc:ns_makecanon",
        "//libc:ns_msg_getflag",
        "//libc:ns_name_compress",
        "//libc:ns_name_ntop",
        "//libc:ns_name_pack",
        "//libc:ns_name_pton",
        "//libc:ns_name_rollback",
        "//libc:ns_name_skip",
        "//libc:ns_name_unpack",
        "//libc:ns_samename",
        "//libc:ns_sprintrr",
        "//libc:types_ns_msg",
        "//libc:types_ns_rr",
    ],
)
