# Tests for LLVM libc android/ functions.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "android_get_application_target_sdk_version_test",
    srcs = ["android_get_application_target_sdk_version_test.cpp"],
    deps = [
        "//libc/hdr:android_api_level_macros",
        "//libc/src/android:get_application_target_sdk_version",
    ],
)

libc_test(
    name = "android_get_device_api_level_test",
    srcs = ["android_get_device_api_level_test.cpp"],
    deps = [
        "//libc/src/android:get_device_api_level",
        "//libc/src/string:strlen",
        "//libc/src/sys/system_properties:__system_property_add",
        "//libc/src/sys/system_properties:__system_property_area_init",
        "//libc/src/sys/system_properties:__system_property_find",
        "//libc/src/sys/system_properties:__system_property_set_filename",
        "//libc/src/sys/system_properties:__system_property_update",
        "//libc/src/unistd:unlink",
    ],
)

