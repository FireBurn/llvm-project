# Tests for LLVM libc android/ functions.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "android_get_application_target_sdk_version_test",
    srcs = ["android_get_application_target_sdk_version_test.cpp"],
    deps = [
        "//libc:android_get_application_target_sdk_version",
        "//libc:hdr_android_api_level_macros",
    ],
)

libc_test(
    name = "android_get_device_api_level_test",
    srcs = ["android_get_device_api_level_test.cpp"],
    deps = [
        "//libc:__system_property_add",
        "//libc:__system_property_area_init",
        "//libc:__system_property_find",
        "//libc:__system_property_set_filename",
        "//libc:__system_property_update",
        "//libc:android_get_device_api_level",
        "//libc:strlen",
        "//libc:unlink",
    ],
)

libc_test(
    name = "fdsan_test",
    srcs = ["fdsan_test.cpp"],
    deps = [
        "//libc:android_fdsan_close_with_tag",
        "//libc:android_fdsan_create_owner_tag",
        "//libc:android_fdsan_exchange_owner_tag",
        "//libc:android_fdsan_get_error_level",
        "//libc:android_fdsan_get_owner_tag",
        "//libc:android_fdsan_get_tag_type",
        "//libc:android_fdsan_get_tag_value",
        "//libc:android_fdsan_set_error_level",
        "//libc:android_fdsan_set_error_level_from_property",
        "//libc:hdr_errno_macros",
        "//libc:hdr_fcntl_macros",
        "//libc:hdr_types_enum_android_fdsan_error_level",
        "//libc:hdr_types_enum_android_fdsan_owner_type",
        "//libc:open",
        "//libc:strcmp",
    ],
)

libc_test(
    name = "set_abort_message_test",
    srcs = ["set_abort_message_test.cpp"],
    deps = [
        "//libc:__support_abort_message",
        "//libc:android_set_abort_message",
        "//libc:strcmp",
        "//libc:strlen",
    ],
)

libc_test(
    name = "crash_detail_test",
