# Tests for LLVM libc android/ functions.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "android_get_application_target_sdk_version_test",
    srcs = ["android_get_application_target_sdk_version_test.cpp"],
    deps = [
        "//libc/hdr:android_api_level_macros",
        "//libc/src/android:get_application_target_sdk_version",
    ],
)

libc_test(
    name = "fdsan_test",
    srcs = ["fdsan_test.cpp"],
    deps = [
        "//libc/hdr/types:hdr_types_enum_android_fdsan_error_level",
        "//libc/hdr/types:hdr_types_enum_android_fdsan_owner_type",
        "//libc/hdr:errno_macros",
        "//libc/hdr:fcntl_macros",
        "//libc/src/android:fdsan_close_with_tag",
        "//libc/src/android:fdsan_create_owner_tag",
        "//libc/src/android:fdsan_exchange_owner_tag",
        "//libc/src/android:fdsan_get_error_level",
        "//libc/src/android:fdsan_get_owner_tag",
        "//libc/src/android:fdsan_get_tag_type",
        "//libc/src/android:fdsan_get_tag_value",
        "//libc/src/android:fdsan_set_error_level",
        "//libc/src/android:fdsan_set_error_level_from_property",
        "//libc/src/fcntl:open",
        "//libc/src/string:strcmp",
    ],
