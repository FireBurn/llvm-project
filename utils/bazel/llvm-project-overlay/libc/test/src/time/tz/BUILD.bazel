# Tests for LLVM libc time/tz.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "posix_tz_test",
    srcs = ["posix_tz_test.cpp"],
    deps = [
        "//libc/hdr/types:time_t",
        "//libc/src/time:tz_posix_tz",
    ],
)

libc_test(
    name = "tzfile_test",
    srcs = ["tzfile_test.cpp"],
    deps = [
        "//libc/hdr/types:size_t",
        "//libc/hdr/types:time_t",
        "//libc/src/time:tz_tzfile",
    ],
)

libc_test(
    name = "tzset_test",
    srcs = ["tzset_test.cpp"],
    deps = [
        "//libc/hdr/types:struct_tm",
        "//libc/hdr/types:time_t",
        "//libc/src/stdlib:setenv",
        "//libc/src/string:strcmp",
        "//libc/src/time:localtime_r",
        "//libc/src/time:mktime",
        "//libc/src/time:time_tzset",
        "//libc/src/time:tz_variables",
        "//libc/src/time:tzset",
    ],
)
