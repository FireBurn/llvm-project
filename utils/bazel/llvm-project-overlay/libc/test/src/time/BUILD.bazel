# Tests for LLVM libc time.

load("//libc/test:libc_test_rules.bzl", "libc_test", "libc_test_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test_library(
    name = "tm_helper",
    hdrs = ["TmHelper.h"],
    deps = [
        "//libc:__support_macros_config",
        "//libc:time_time_constants",
        "//libc:types_struct_tm",
    ],
)

libc_test_library(
    name = "tm_matcher",
    hdrs = ["TmMatcher.h"],
    deps = [
        "//libc:__support_macros_config",
        "//libc:types_struct_tm",
        "//libc/test/UnitTest:LibcUnitTest",
    ],
)

libc_test_library(
    name = "tz_fixture",
    hdrs = ["TzFixture.h"],
    deps = [
        "//libc:setenv",
        "//libc:tzset",
        "//libc/test/UnitTest:LibcUnitTest",
    ],
)

libc_test(
    name = "strftime_test",
    srcs = ["strftime_test.cpp"],
    deps = [
        "//libc:__support_cpp_array",
        "//libc:__support_integer_to_string",
        "//libc:strftime",
        "//libc:time_time_constants",
        "//libc:types_struct_tm",
    ],
)

libc_test(
    name = "strptime_test",
    srcs = ["strptime_test.cpp"],
    deps = [
        "//libc:memset",
        "//libc:strptime",
        "//libc:types_struct_tm",
    ],
)

libc_test(
    name = "timegm_test",
    srcs = ["timegm_test.cpp"],
    deps = [
        "//libc:gmtime_r",
        "//libc:timegm",
        "//libc:types_struct_tm",
        "//libc:types_time_t",
    ],
)

libc_test(
    name = "clock_nanosleep_test",
    srcs = ["clock_nanosleep_test.cpp"],
    deps = [
        "//libc:clock_gettime",
        "//libc:clock_nanosleep",
        "//libc:hdr_errno_macros",
        "//libc:hdr_time_macros",
        "//libc:time_clock_nanosleep",
        "//libc:types_struct_timespec",
    ],
)

libc_test(
    name = "ctime_test",
    srcs = ["ctime_test.cpp"],
    deps = [
        ":tm_helper",
        ":tz_fixture",
        "//libc:ctime",
        "//libc:hdr_signal_macros",
        "//libc:time_time_utils",
    ],
)

libc_test(
    name = "ctime_r_test",
    srcs = ["ctime_r_test.cpp"],
    deps = [
        ":tm_helper",
        ":tz_fixture",
        "//libc:ctime_r",
        "//libc:hdr_signal_macros",
        "//libc:time_time_constants",
        "//libc:time_time_utils",
    ],
)

libc_test(
    name = "localtime_test",
    srcs = ["localtime_test.cpp"],
    deps = [
        ":tz_fixture",
        "//libc:hdr_signal_macros",
        "//libc:localtime",
    ],
)

libc_test(
    name = "localtime_r_test",
    srcs = ["localtime_r_test.cpp"],
    deps = [
        ":tz_fixture",
        "//libc:hdr_signal_macros",
        "//libc:localtime_r",
    ],
)

libc_test(
    name = "mktime_test",
    srcs = ["mktime_test.cpp"],
    deps = [
        ":tm_helper",
        ":tm_matcher",
        ":tz_fixture",
        "//libc:__support_cpp_limits",
        "//libc:mktime",
        "//libc:time_time_constants",
        "//libc:time_time_utils",
    ],
)
