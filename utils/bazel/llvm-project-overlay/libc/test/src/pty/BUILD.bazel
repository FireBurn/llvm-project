# Tests for LLVM libc pty.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "pty_test",
    srcs = ["pty_test.cpp"],
    deps = [
        "//libc:_Exit",
        "//libc:close",
        "//libc:fork",
        "//libc:forkpty",
        "//libc:hdr_errno_macros",
        "//libc:hdr_fcntl_macros",
        "//libc:isatty",
        "//libc:login_tty",
        "//libc:memcmp",
        "//libc:open",
        "//libc:openpty",
        "//libc:read",
        "//libc:strlen",
        "//libc:termios_tcgetattr",
        "//libc:types_struct_termios",
        "//libc:types_struct_winsize",
        "//libc:waitpid",
        "//libc:write",
    ],
)
