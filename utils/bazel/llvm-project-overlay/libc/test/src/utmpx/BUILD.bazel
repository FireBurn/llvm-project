# Tests for LLVM libc utmpx.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "utmpx_test",
    srcs = ["utmpx_test.cpp"],
    deps = [
        "//libc:close",
        "//libc:endutxent",
        "//libc:getutxent",
        "//libc:getutxid",
        "//libc:getutxline",
        "//libc:hdr_fcntl_macros",
        "//libc:hdr_sys_stat_macros",
        "//libc:open",
        "//libc:pututxline",
        "//libc:remove",
        "//libc:setutxent",
        "//libc:strcpy",
        "//libc:strncmp",
        "//libc:types_struct_utmpx",
        "//libc:updwtmpx",
        "//libc:utmpxname",
    ],
)
