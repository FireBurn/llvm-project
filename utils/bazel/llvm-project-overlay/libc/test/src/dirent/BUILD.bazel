# Tests for LLVM libc dirent.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "versionsort_test",
    srcs = ["versionsort_test.cpp"],
    deps = [
        "//libc:strcpy",
        "//libc:types_struct_dirent",
        "//libc:versionsort",
    ],
)

libc_test(
    name = "rewinddir_test",
    srcs = ["rewinddir_test.cpp"],
    deps = [
        "//libc:__support_cpp_string_view",
        "//libc:close",
        "//libc:closedir",
        "//libc:dirent_readdir",
        "//libc:hdr_fcntl_macros",
        "//libc:mkdir",
        "//libc:open",
        "//libc:opendir",
        "//libc:rewinddir",
        "//libc:rmdir",
        "//libc:seekdir",
        "//libc:telldir",
        "//libc:unlink",
    ],
)
