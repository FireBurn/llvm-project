# Tests for LLVM libc dirent.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "versionsort_test",
    srcs = ["versionsort_test.cpp"],
    deps = [
        "//libc:strcpy",
        "//libc:types_struct_dirent",
        "//libc:versionsort",
    ],
)

libc_test(
    name = "struct_dirent_test",
    srcs = ["struct_dirent_test.cpp"],
    deps = [
        "//libc:hdr_limits_macros",
        "//libc:strlen",
        "//libc:types_struct_dirent",
    ],
)

libc_test(
    name = "dirent_test",
    srcs = ["dirent_test.cpp"],
    deps = [
        "//libc:__support_cpp_string_view",
        "//libc:close",
        "//libc:closedir",
        "//libc:dirent_readdir",
        "//libc:dirfd",
        "//libc:hdr_fcntl_macros",
        "//libc:hdr_sys_stat_macros",
        "//libc:mkdir",
        "//libc:open",
        "//libc:opendir",
        "//libc:rmdir",
        "//libc:unlink",
    ],
)

libc_test(
    name = "rewinddir_test",
    srcs = ["rewinddir_test.cpp"],
    deps = [
        "//libc:__support_cpp_string_view",
        "//libc:close",
        "//libc:closedir",
        "//libc:dirent_readdir",
        "//libc:hdr_fcntl_macros",
        "//libc:mkdir",
        "//libc:open",
        "//libc:opendir",
        "//libc:rewinddir",
        "//libc:rmdir",
        "//libc:seekdir",
        "//libc:telldir",
        "//libc:unlink",
    ],
)

libc_test(
    name = "getdents64_test",
    srcs = ["getdents64_test.cpp"],
    deps = [
        "//libc:close",
        "//libc:getdents64",
        "//libc:hdr_errno_macros",
        "//libc:hdr_fcntl_macros",
        "//libc:open",
        "//libc:strcmp",
        "//libc:types_struct_dirent",
    ],
)

libc_test(
    name = "readdir_r_test",
    srcs = ["readdir_r_test.cpp"],
    deps = [
        "//libc:closedir",
        "//libc:opendir",
        "//libc:readdir_r",
        "//libc:strcmp",
        "//libc:types_struct_dirent",
    ],
)

libc_test(
    name = "getdents_test",
    srcs = ["getdents_test.cpp"],
    deps = [
        "//libc:close",
        "//libc:getdents",
        "//libc:hdr_errno_macros",
        "//libc:hdr_fcntl_macros",
        "//libc:open",
        "//libc:strcmp",
        "//libc:types_struct_dirent",
    ],
)
