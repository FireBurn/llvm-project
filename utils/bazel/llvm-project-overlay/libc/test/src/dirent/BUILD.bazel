# Tests for LLVM libc dirent.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "versionsort_test",
    srcs = ["versionsort_test.cpp"],
    deps = [
        "//libc/hdr/types:struct_dirent",
        "//libc/src/dirent:versionsort",
        "//libc/src/string:strcpy",
    ],
)

libc_test(
    name = "struct_dirent_test",
    srcs = ["struct_dirent_test.cpp"],
    deps = [
        "//libc/hdr/types:struct_dirent",
        "//libc/hdr:limits_macros",
        "//libc/src/string:strlen",
    ],
)

libc_test(
    name = "dirent_test",
    srcs = ["dirent_test.cpp"],
    deps = [
        "//libc/hdr:fcntl_macros",
        "//libc/hdr:sys_stat_macros",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/dirent:closedir",
        "//libc/src/dirent:dirfd",
        "//libc/src/dirent:opendir",
        "//libc/src/dirent:readdir",
        "//libc/src/fcntl:open",
        "//libc/src/sys/stat:mkdir",
        "//libc/src/unistd:close",
        "//libc/src/unistd:rmdir",
        "//libc/src/unistd:unlink",
    ],
)

libc_test(
    name = "rewinddir_test",
    srcs = ["rewinddir_test.cpp"],
    deps = [
        "//libc/hdr:fcntl_macros",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/dirent:closedir",
        "//libc/src/dirent:opendir",
        "//libc/src/dirent:readdir",
        "//libc/src/dirent:rewinddir",
        "//libc/src/dirent:seekdir",
        "//libc/src/dirent:telldir",
        "//libc/src/fcntl:open",
        "//libc/src/sys/stat:mkdir",
        "//libc/src/unistd:close",
        "//libc/src/unistd:rmdir",
        "//libc/src/unistd:unlink",
    ],
)

libc_test(
    name = "getdents64_test",
    srcs = ["getdents64_test.cpp"],
    deps = [
        "//libc/hdr/types:struct_dirent",
        "//libc/hdr:errno_macros",
        "//libc/hdr:fcntl_macros",
        "//libc/src/dirent:getdents64",
        "//libc/src/fcntl:open",
        "//libc/src/string:strcmp",
        "//libc/src/unistd:close",
    ],
)

libc_test(
    name = "readdir_r_test",
    srcs = ["readdir_r_test.cpp"],
    deps = [
        "//libc/hdr/types:struct_dirent",
        "//libc/src/dirent:closedir",
        "//libc/src/dirent:opendir",
        "//libc/src/dirent:readdir_r",
        "//libc/src/string:strcmp",
    ],
)
