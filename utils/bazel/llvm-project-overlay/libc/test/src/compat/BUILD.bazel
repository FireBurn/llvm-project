# Tests for LLVM libc compat.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "syscall_test",
    srcs = ["syscall_test.cpp"],
    deps = [
        "//libc:__support_macros_properties_architectures",
        "//libc:__support_osutil_syscall",
        "//libc:syscall",
    ],
)

libc_test(
    name = "compat_test",
    srcs = ["compat_test.cpp"],
    deps = [
        "//libc:__xpg_strerror_r",
        "//libc:close",
        "//libc:closedir",
        "//libc:fclose",
        "//libc:fputs",
        "//libc:getpid",
        "//libc:gnu_get_libc_version",
        "//libc:hdr_errno_macros",
        "//libc:hdr_fcntl_macros",
        "//libc:hdr_stdio_macros",
        "//libc:hdr_sys_stat_macros",
        "//libc:lfs64",
        "//libc:opendir",
        "//libc:strcmp",
        "//libc:strlen",
        "//libc:syscall",
        "//libc:write",
    ],
)
