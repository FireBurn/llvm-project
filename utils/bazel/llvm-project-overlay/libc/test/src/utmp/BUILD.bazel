# Tests for LLVM libc utmp.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "utmp_test",
    srcs = ["utmp_test.cpp"],
    deps = [
        "//libc:__support_cpp_string_view",
        "//libc:close",
        "//libc:endutent",
        "//libc:getutent",
        "//libc:getutent_r",
        "//libc:getutid",
        "//libc:getutid_r",
        "//libc:getutline",
        "//libc:getutline_r",
        "//libc:hdr_fcntl_macros",
        "//libc:hdr_sys_stat_macros",
        "//libc:logout",
        "//libc:logwtmp",
        "//libc:open",
        "//libc:pututline",
        "//libc:remove",
        "//libc:setutent",
        "//libc:strcpy",
        "//libc:strncmp",
        "//libc:types_struct_utmp",
        "//libc:updwtmp",
        "//libc:utmpname",
    ],
)
