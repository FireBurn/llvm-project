# Tests for LLVM libc ifaddrs.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "getifaddrs_test",
    srcs = ["getifaddrs_test.cpp"],
    deps = [
        "//libc:freeifaddrs",
        "//libc:getifaddrs",
        "//libc:hdr_net_if_macros",
        "//libc:hdr_sys_socket_macros",
        "//libc:strcmp",
        "//libc:types_struct_ifaddrs",
    ],
)
