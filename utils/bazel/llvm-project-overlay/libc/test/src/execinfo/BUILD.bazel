# Tests for LLVM libc execinfo.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "backtrace_test",
    srcs = ["backtrace_test.cpp"],
    deps = [
        "//libc/hdr:fcntl_macros",
        "//libc/hdr:sys_stat_macros",
        "//libc/src/execinfo:backtrace",
        "//libc/src/execinfo:backtrace_symbols_fd",
        "//libc/src/fcntl:open",
        "//libc/src/sys/stat:fstat",
        "//libc/src/unistd:close",
        "//libc/src/unistd:unlink",
    ],
)

libc_test(
    name = "backtrace_symbols_test",
    srcs = ["backtrace_symbols_test.cpp"],
    deps = [
        "//libc/hdr/types:size_t",
        "//libc/src/execinfo:backtrace_symbols",
        "//libc/src/string:strlen",
        "//libc/src/string:strstr",
    ],
)
