# Tests for LLVM libc error.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "error_test",
    srcs = ["error_test.cpp"],
    deps = [
        "//libc:error",
        "//libc:error_message_count",
        "//libc:error_print_progname",
    ],
)

libc_test(
    name = "error_at_line_test",
    srcs = ["error_at_line_test.cpp"],
    deps = [
        "//libc:error_at_line",
        "//libc:error_message_count",
        "//libc:error_one_per_line",
    ],
)
