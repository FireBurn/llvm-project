# Tests for LLVM libc error.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "error_test",
    srcs = ["error_test.cpp"],
    deps = [
        "//libc/src/error:error",
        "//libc/src/error:message_count",
        "//libc/src/error:print_progname",
    ],
)

libc_test(
    name = "error_at_line_test",
    srcs = ["error_at_line_test.cpp"],
    deps = [
        "//libc/src/error:at_line",
        "//libc/src/error:message_count",
        "//libc/src/error:one_per_line",
    ],
)
