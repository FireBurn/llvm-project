# Tests for LLVM libc locale.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "locale_test",
    srcs = ["locale_test.cpp"],
    deps = [
        "//libc:freelocale",
        "//libc:hdr_langinfo_macros",
        "//libc:hdr_locale_macros",
        "//libc:newlocale",
        "//libc:setlocale",
        "//libc:uselocale",
    ],
)

libc_test(
    name = "setlocale_test",
    srcs = ["setlocale_test.cpp"],
    deps = [
        "//libc:hdr_langinfo_macros",
        "//libc:hdr_locale_macros",
        "//libc:mb_cur_max",
        "//libc:nl_langinfo",
        "//libc:setenv",
        "//libc:setlocale",
        "//libc:unsetenv",
    ],
)
