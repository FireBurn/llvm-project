# Tests for LLVM libc locale.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "environment_value_test",
    srcs = ["environment_value_test.cpp"],
    deps = [
        "//libc/src/__support/CPP:string_view",
        "//libc/src/locale:locale",
        "//libc/src/locale:locale_data",
        "//libc/src/stdlib:setenv",
        "//libc/src/stdlib:unsetenv",
    ],
)

libc_test(
    name = "locale_test",
    srcs = ["locale_test.cpp"],
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/hdr:langinfo_macros",
        "//libc/hdr:locale_macros",
        "//libc/src/__support/CPP:scope",
        "//libc/src/locale:freelocale",
        "//libc/src/locale:newlocale",
        "//libc/src/locale:setlocale",
        "//libc/src/locale:uselocale",
    ],
)

libc_test(
    name = "setlocale_test",
    srcs = ["setlocale_test.cpp"],
    deps = [
        "//libc/hdr:langinfo_macros",
        "//libc/hdr:locale_macros",
        "//libc/src/langinfo:nl_langinfo",
        "//libc/src/locale:setlocale",
        "//libc/src/stdlib:mb_cur_max",
        "//libc/src/stdlib:setenv",
        "//libc/src/stdlib:unsetenv",
    ],
)
