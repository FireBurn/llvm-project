# Tests for LLVM libc shadow.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "shadow_utils_test",
    srcs = ["shadow_utils_test.cpp"],
    deps = [
        "//libc:__support_cpp_span",
        "//libc:shadow_shadow_utils",
        "//libc:types_struct_spwd",
    ],
)

libc_test(
    name = "shadow_test",
    srcs = ["shadow_test.cpp"],
    deps = [
        "//libc:endspent",
        "//libc:fclose",
        "//libc:fgetspent",
        "//libc:fgetspent_r",
        "//libc:fopen",
        "//libc:fwrite",
        "//libc:getspent",
        "//libc:getspent_r",
        "//libc:getspnam",
        "//libc:getspnam_r",
        "//libc:hdr_errno_macros",
        "//libc:lckpwdf",
        "//libc:putspent",
        "//libc:remove",
        "//libc:setspent",
        "//libc:sgetspent",
        "//libc:sgetspent_r",
        "//libc:shadow_shadow_utils",
        "//libc:types_FILE",
        "//libc:types_struct_spwd",
        "//libc:ulckpwdf",
    ],
)
