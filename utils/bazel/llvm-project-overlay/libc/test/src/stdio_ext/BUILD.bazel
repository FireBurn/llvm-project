# Tests for LLVM libc stdio_ext.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "stdio_ext_test",
    srcs = ["stdio_ext_test.cpp"],
    deps = [
        "//libc:__fbufsize",
        "//libc:__flbf",
        "//libc:__fpending",
        "//libc:__fpurge",
        "//libc:__freadable",
        "//libc:__freading",
        "//libc:__fwritable",
        "//libc:__fwriting",
        "//libc:fclose",
        "//libc:ferror",
        "//libc:fflush",
        "//libc:fgetc",
        "//libc:fopen",
        "//libc:fwrite",
        "//libc:remove",
        "//libc:types_FILE",
    ],
)
