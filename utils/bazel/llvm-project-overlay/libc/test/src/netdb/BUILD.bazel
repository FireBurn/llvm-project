# Tests for LLVM libc netdb.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "getnameinfo_test",
    srcs = ["getnameinfo_test.cpp"],
    deps = [
        "//libc:__support_cpp_string_view",
        "//libc:getnameinfo",
        "//libc:hdr_netdb_macros",
        "//libc:htons",
        "//libc:net_if_if_nametoindex",
        "//libc:types_struct_sockaddr",
        "//libc:types_struct_sockaddr_in",
        "//libc:types_struct_sockaddr_in6",
    ],
)

libc_test(
    name = "h_errno_test",
    srcs = ["h_errno_test.cpp"],
    deps = [
        "//libc:__h_errno_location",
    ],
)

libc_test(
    name = "gethostbyname_test",
    srcs = ["gethostbyname_test.cpp"],
    deps = [
        "//libc:__h_errno_location",
        "//libc:gethostbyname",
        "//libc:gethostbyname2",
        "//libc:getservbyname",
        "//libc:hdr_netdb_macros",
        "//libc:hdr_sys_socket_macros",
        "//libc:strcmp",
        "//libc:types_struct_hostent",
        "//libc:types_struct_servent",
    ],
)

libc_test(
    name = "getaddrinfo_test",
    srcs = ["getaddrinfo_test.cpp"],
    deps = [
        "//libc:freeaddrinfo",
        "//libc:getaddrinfo",
        "//libc:hdr_netdb_macros",
        "//libc:hdr_sys_socket_macros",
        "//libc:net_if_if_nametoindex",
        "//libc:types_struct_addrinfo",
        "//libc:types_struct_sockaddr_in",
        "//libc:types_struct_sockaddr_in6",
    ],
)
