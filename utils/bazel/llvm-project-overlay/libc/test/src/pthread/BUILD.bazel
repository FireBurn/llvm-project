# Tests for LLVM libc pthread.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "pthread_barrierattr_test",
    srcs = ["pthread_barrierattr_test.cpp"],
    deps = [
        "//libc:hdr_errno_macros",
        "//libc:pthread_barrierattr_destroy",
        "//libc:pthread_barrierattr_getpshared",
        "//libc:pthread_barrierattr_init",
        "//libc:pthread_barrierattr_setpshared",
    ],
)

libc_test(
    name = "pthread_monotonic_np_test",
    srcs = ["pthread_monotonic_np_test.cpp"],
    deps = [
        "//libc:clock_gettime",
        "//libc:hdr_errno_macros",
        "//libc:hdr_time_macros",
        "//libc:pthread_cond_destroy",
        "//libc:pthread_cond_init",
        "//libc:pthread_cond_timedwait_monotonic_np",
        "//libc:pthread_mutex_clocklock",
        "//libc:pthread_mutex_destroy",
        "//libc:pthread_mutex_init",
        "//libc:pthread_mutex_lock",
        "//libc:pthread_mutex_timedlock_monotonic_np",
        "//libc:pthread_mutex_unlock",
        "//libc:pthread_rwlock_destroy",
        "//libc:pthread_rwlock_init",
        "//libc:pthread_rwlock_timedrdlock_monotonic_np",
        "//libc:pthread_rwlock_timedwrlock_monotonic_np",
        "//libc:pthread_rwlock_unlock",
        "//libc:sem_destroy",
        "//libc:sem_init",
        "//libc:sem_post",
        "//libc:sem_timedwait_monotonic_np",
        "//libc:types_struct_timespec",
    ],
)

