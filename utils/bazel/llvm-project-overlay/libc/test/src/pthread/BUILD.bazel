# Tests for LLVM libc pthread.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "pthread_mutexattr_test",
    srcs = ["pthread_mutexattr_test.cpp"],
    deps = [
        "//libc:hdr_errno_macros",
        "//libc:pthread_mutexattr_destroy",
        "//libc:pthread_mutexattr_getprotocol",
        "//libc:pthread_mutexattr_getpshared",
        "//libc:pthread_mutexattr_getrobust",
        "//libc:pthread_mutexattr_gettype",
        "//libc:pthread_mutexattr_init",
        "//libc:pthread_mutexattr_setprotocol",
        "//libc:pthread_mutexattr_setpshared",
        "//libc:pthread_mutexattr_setrobust",
        "//libc:pthread_mutexattr_settype",
    ],
)

libc_test(
    name = "pthread_cancel_test",
    srcs = ["pthread_cancel_test.cpp"],
    deps = [
        "//libc:__pthread_cleanup_pop",
        "//libc:__pthread_cleanup_push",
        "//libc:__support_cpp_atomic",
        "//libc:close",
        "//libc:hdr_errno_macros",
        "//libc:pipe",
        "//libc:pthread_cancel",
        "//libc:pthread_create",
        "//libc:pthread_join",
        "//libc:pthread_setcancelstate",
        "//libc:pthread_setcanceltype",
        "//libc:pthread_testcancel",
        "//libc:read",
        "//libc:write",
    ],
)

libc_test(
    name = "pthread_affinity_test",
    srcs = ["pthread_affinity_test.cpp"],
    deps = [
        "//libc:sched_sched_getcpucount",
        "//libc:__sched_getcpuisset",
        "//libc:__sched_setcpuset",
        "//libc:hdr_errno_macros",
        "//libc:memset",
        "//libc:pthread_getaffinity_np",
        "//libc:pthread_self",
        "//libc:pthread_setaffinity_np",
        "//libc:types_cpu_set_t",
    ],
)
