# Tests for LLVM libc glob.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "glob_test",
    srcs = ["glob_test.cpp"],
    deps = [
        "//libc:__support_cpp_string_view",
        "//libc:close",
        "//libc:glob",
        "//libc:globfree",
        "//libc:hdr_fcntl_macros",
        "//libc:hdr_glob_macros",
        "//libc:hdr_sys_stat_macros",
        "//libc:mkdir",
        "//libc:open",
        "//libc:remove",
        "//libc:rmdir",
        "//libc:types_glob_t",
        "//libc:types_struct_dirent",
        "//libc:types_struct_stat",
    ],
)
