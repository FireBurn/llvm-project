# Tests for LLVM libc pwd.

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

cc_library(
    name = "pwd_test_utils",
    testonly = True,
    hdrs = ["pwd_test_utils.h"],
    deps = [
        "//libc:__support_file_file",
        "//libc:hdr_stdint_proxy",
        "//libc:pwd_pwd_utils",
        "//libc:remove",
        "//libc:string_utils",
        "//libc:types_size_t",
        "//libc/test/UnitTest:LibcUnitTest",
    ],
)

libc_test(
    name = "pwd_utils_test",
    srcs = ["pwd_utils_test.cpp"],
    deps = [
        "//libc:hdr_errno_macros",
        "//libc:pwd_pwd_utils",
        "//libc:types_struct_passwd",
    ],
)

libc_test(
    name = "fgetpwent_test",
    srcs = ["fgetpwent_test.cpp"],
    deps = [
        "//libc:__support_cpp_string_view",
        "//libc:close",
        "//libc:fclose",
        "//libc:fgetpwent",
        "//libc:fopen",
        "//libc:hdr_errno_macros",
        "//libc:hdr_fcntl_macros",
        "//libc:hdr_sys_stat_macros",
        "//libc:open",
        "//libc:putpwent",
        "//libc:remove",
        "//libc:types_FILE",
        "//libc:types_struct_passwd",
        "//libc:write",
    ],
)

libc_test(
    name = "putpwent_test",
    srcs = ["putpwent_test.cpp"],
    deps = [
        "//libc:fclose",
        "//libc:hdr_errno_macros",
        "//libc:open_memstream",
        "//libc:putpwent",
        "//libc:types_FILE",
        "//libc:types_struct_passwd",
    ],
)
