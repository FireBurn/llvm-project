# Tests for LLVM libc netinet/ether.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "ether_hostton_test",
    srcs = ["ether_hostton_test.cpp"],
    deps = [
        "//libc/hdr/types:struct_ether_addr",
        "//libc/hdr:fcntl_macros",
        "//libc/hdr:sys_stat_macros",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/fcntl:open",
        "//libc/src/netinet:ether_ethers",
        "//libc/src/netinet:ether_hostton",
        "//libc/src/netinet:ether_ntohost",
        "//libc/src/stdio:remove",
        "//libc/src/unistd:close",
        "//libc/src/unistd:write",
    ],
)
