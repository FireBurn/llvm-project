# Tests for LLVM libc grp.

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

cc_library(
    name = "grp_test_utils",
    testonly = True,
    hdrs = ["grp_test_utils.h"],
    deps = [
        "//libc:__support_file_file",
        "//libc:hdr_stdint_proxy",
        "//libc:grp_grp_utils",
        "//libc:remove",
        "//libc:string_utils",
        "//libc:types_size_t",
        "//libc/test/UnitTest:LibcUnitTest",
    ],
)

libc_test(
    name = "grp_utils_test",
    srcs = ["grp_utils_test.cpp"],
    deps = [
        "//libc:__support_cpp_span",
        "//libc:__support_pwd_flat_file_db",
        "//libc:grp_grp_utils",
        "//libc:hdr_errno_macros",
        "//libc:types_gid_t",
        "//libc:types_size_t",
        "//libc:types_struct_group",
    ],
)

libc_test(
    name = "getgrent_test",
    srcs = ["getgrent_test.cpp"],
    deps = [
        ":grp_test_utils",
        "//libc:__support_ctype_utils",
        "//libc:__support_file_file",
        "//libc:__support_file_platform_file",
        "//libc:endgrent",
        "//libc:getgrent",
        "//libc:getgrent_r",
        "//libc:grp_grp_utils",
        "//libc:hdr_errno_macros",
        "//libc:remove",
        "//libc:setgrent",
        "//libc:string_utils",
        "//libc:types_gid_t",
        "//libc:types_size_t",
        "//libc:types_struct_group",
    ],
)

libc_test(
    name = "fgetgrent_test",
    srcs = ["fgetgrent_test.cpp"],
    deps = [
        "//libc:__support_cpp_string_view",
        "//libc:close",
        "//libc:fclose",
        "//libc:fgetgrent",
        "//libc:fgetgrent_r",
        "//libc:fopen",
        "//libc:getgrouplist",
        "//libc:grp_grp_utils",
        "//libc:hdr_errno_macros",
        "//libc:hdr_fcntl_macros",
        "//libc:hdr_sys_stat_macros",
        "//libc:open",
        "//libc:putgrent",
        "//libc:remove",
        "//libc:types_FILE",
        "//libc:types_struct_group",
        "//libc:write",
    ],
)

libc_test(
    name = "putgrent_test",
    srcs = ["putgrent_test.cpp"],
    deps = [
        "//libc:fclose",
        "//libc:hdr_errno_macros",
        "//libc:open_memstream",
        "//libc:putgrent",
        "//libc:types_FILE",
        "//libc:types_struct_group",
    ],
)
