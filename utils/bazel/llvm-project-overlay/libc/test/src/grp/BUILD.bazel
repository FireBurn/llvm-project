# Tests for LLVM libc grp.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "grp_utils_test",
    srcs = ["grp_utils_test.cpp"],
    deps = [
        "//libc:__support_cpp_span",
        "//libc:__support_pwd_flat_file_db",
        "//libc:grp_grp_utils",
        "//libc:hdr_errno_macros",
        "//libc:types_gid_t",
        "//libc:types_size_t",
        "//libc:types_struct_group",
    ],
)

libc_test(
    name = "fgetgrent_test",
    srcs = ["fgetgrent_test.cpp"],
    deps = [
        "//libc:__support_cpp_string_view",
        "//libc:close",
        "//libc:fclose",
        "//libc:fgetgrent",
        "//libc:fopen",
        "//libc:getgrouplist",
        "//libc:grp_grp_utils",
        "//libc:hdr_errno_macros",
        "//libc:hdr_fcntl_macros",
        "//libc:hdr_sys_stat_macros",
        "//libc:open",
        "//libc:putgrent",
        "//libc:remove",
        "//libc:types_FILE",
        "//libc:types_struct_group",
        "//libc:write",
    ],
)

libc_test(
    name = "putgrent_test",
    srcs = ["putgrent_test.cpp"],
    deps = [
        "//libc:fclose",
        "//libc:hdr_errno_macros",
        "//libc:open_memstream",
        "//libc:putgrent",
        "//libc:types_FILE",
        "//libc:types_struct_group",
    ],
)
