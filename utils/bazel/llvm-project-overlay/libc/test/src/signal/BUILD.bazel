# Tests for LLVM libc signal.h functions.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "sigaction_test",
    srcs = ["sigaction_test.cpp"],
    full_build_only = True,
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/hdr:signal_macros",
        "//libc/src/signal:raise",
        "//libc/src/signal:sigaction",
    ],
)

libc_test(
    name = "sigqueue_basic_test",
    srcs = ["sigqueue_basic_test.cpp"],
    deps = [
        "//libc/hdr/types:siginfo_t",
        "//libc/hdr/types:sigset_t",
        "//libc/hdr:errno_macros",
        "//libc/hdr:signal_macros",
        "//libc/src/signal:sigaddset",
        "//libc/src/signal:sigemptyset",
        "//libc/src/signal:sigisemptyset",
        "//libc/src/signal:signal_sigqueue",
        "//libc/src/signal:sigprocmask",
        "//libc/src/signal:sigqueue",
        "//libc/src/signal:sigwaitinfo",
        "//libc/src/unistd:getpid",
    ],
)

libc_test(
    name = "sigqueue_test",
    srcs = ["sigqueue_test.cpp"],
    deps = [
        "//libc/hdr/types:siginfo_t",
        "//libc/hdr/types:sigset_t",
        "//libc/hdr/types:struct_timespec",
        "//libc/hdr:errno_macros",
        "//libc/hdr:signal_macros",
        "//libc/src/signal:killpg",
        "//libc/src/signal:sigaddset",
        "//libc/src/signal:sigemptyset",
        "//libc/src/signal:sigisemptyset",
        "//libc/src/signal:sigismember",
        "//libc/src/signal:signal_sigpending",
        "//libc/src/signal:signal_sigqueue",
        "//libc/src/signal:sigpending",
        "//libc/src/signal:sigprocmask",
        "//libc/src/signal:sigqueue",
        "//libc/src/signal:sigtimedwait",
        "//libc/src/signal:sigwaitinfo",
        "//libc/src/unistd:getpgrp",
        "//libc/src/unistd:getpid",
    ],
)

libc_test(
    name = "siginterrupt_test",
    srcs = ["siginterrupt_test.cpp"],
    deps = [
        "//libc/hdr/types:struct_sigaction",
        "//libc/hdr:signal_macros",
        "//libc/src/signal:sigaction",
        "//libc/src/signal:sigemptyset",
        "//libc/src/signal:siginterrupt",
    ],
)

libc_test(
    name = "psignal_test",
    srcs = ["psignal_test.cpp"],
    deps = [
        "//libc/hdr:signal_macros",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/StringUtil:StringUtil",
        "//libc/src/signal:psignal",
        "//libc/src/unistd:close",
        "//libc/src/unistd:dup",
        "//libc/src/unistd:dup2",
        "//libc/src/unistd:pipe",
        "//libc/src/unistd:read",
    ],
)

libc_test(
    name = "sigtimedwait_test",
    srcs = ["sigtimedwait_test.cpp"],
    deps = [
        "//libc/hdr/types:siginfo_t",
        "//libc/hdr/types:sigset_t",
        "//libc/hdr/types:struct_sigaction",
        "//libc/hdr/types:struct_timespec",
        "//libc/hdr:errno_macros",
        "//libc/hdr:signal_macros",
        "//libc/src/signal:kill",
        "//libc/src/signal:raise",
        "//libc/src/signal:sigaction",
        "//libc/src/signal:sigaddset",
        "//libc/src/signal:sigemptyset",
        "//libc/src/signal:sigprocmask",
        "//libc/src/signal:sigtimedwait",
        "//libc/src/signal:sigwaitinfo",
        "//libc/src/unistd:getpid",
    ],
