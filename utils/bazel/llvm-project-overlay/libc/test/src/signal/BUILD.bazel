# Tests for LLVM libc signal.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "sigtimedwait_test",
    srcs = ["sigtimedwait_test.cpp"],
    deps = [
        "//libc:getpid",
        "//libc:hdr_errno_macros",
        "//libc:hdr_signal_macros",
        "//libc:kill",
        "//libc:sigaddset",
        "//libc:sigemptyset",
        "//libc:signal_sigtimedwait",
        "//libc:sigprocmask",
        "//libc:sigtimedwait",
        "//libc:sigwaitinfo",
        "//libc:types_siginfo_t",
        "//libc:types_sigset_t",
        "//libc:types_struct_timespec",
    ],
)

