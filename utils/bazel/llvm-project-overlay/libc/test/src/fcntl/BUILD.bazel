# Tests for LLVM libc fcntl.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "allocate_test",
    srcs = ["allocate_test.cpp"],
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/hdr:fcntl_macros",
        "//libc/hdr:sys_stat_macros",
        "//libc/src/fcntl:fallocate",
        "//libc/src/fcntl:open",
        "//libc/src/fcntl:posix_fadvise",
        "//libc/src/fcntl:posix_fallocate",
        "//libc/src/sys/stat:fstat",
        "//libc/src/sys/stat:sys_stat_fstat",
        "//libc/src/unistd:close",
        "//libc/src/unistd:unlink",
    ],
)

libc_test(
    name = "splice_test",
    srcs = ["splice_test.cpp"],
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/hdr:fcntl_macros",
        "//libc/hdr:sys_stat_macros",
        "//libc/src/fcntl:fcntl_splice",
        "//libc/src/fcntl:open",
        "//libc/src/fcntl:splice",
        "//libc/src/string:memcmp",
        "//libc/src/unistd:close",
        "//libc/src/unistd:pipe",
        "//libc/src/unistd:read",
        "//libc/src/unistd:unlink",
        "//libc/src/unistd:write",
    ],
)

libc_test(
    name = "file_handle_test",
    srcs = ["file_handle_test.cpp"],
    deps = [
        "//libc/hdr/types:struct_file_handle",
        "//libc/hdr:errno_macros",
        "//libc/hdr:fcntl_macros",
        "//libc/hdr:sys_stat_macros",
        "//libc/src/fcntl:fcntl_name_to_handle_at",
        "//libc/src/fcntl:fcntl_open_by_handle_at",
        "//libc/src/fcntl:name_to_handle_at",
        "//libc/src/fcntl:open",
        "//libc/src/fcntl:open_by_handle_at",
        "//libc/src/string:memcmp",
        "//libc/src/unistd:close",
        "//libc/src/unistd:read",
        "//libc/src/unistd:unlink",
        "//libc/src/unistd:write",
    ],
)
