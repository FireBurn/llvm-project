# Tests for LLVM libc fcntl.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "splice_test",
    srcs = ["splice_test.cpp"],
    deps = [
        "//libc:close",
        "//libc:fcntl_splice",
        "//libc:hdr_errno_macros",
        "//libc:hdr_fcntl_macros",
        "//libc:hdr_sys_stat_macros",
        "//libc:memcmp",
        "//libc:open",
        "//libc:pipe",
        "//libc:read",
        "//libc:splice",
        "//libc:unlink",
        "//libc:write",
    ],
)
