# Tests for LLVM libc fcntl.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "allocate_test",
    srcs = ["allocate_test.cpp"],
    deps = [
        "//libc:close",
        "//libc:fcntl_fallocate",
        "//libc:fcntl_posix_fallocate",
        "//libc:fstat",
        "//libc:hdr_errno_macros",
        "//libc:hdr_fcntl_macros",
        "//libc:hdr_sys_stat_macros",
        "//libc:open",
        "//libc:posix_fadvise",
        "//libc:sys_stat_fstat",
        "//libc:unlink",
    ],
)

libc_test(
    name = "splice_test",
    srcs = ["splice_test.cpp"],
    deps = [
        "//libc:close",
        "//libc:fcntl_splice",
        "//libc:hdr_errno_macros",
        "//libc:hdr_fcntl_macros",
        "//libc:hdr_sys_stat_macros",
        "//libc:memcmp",
        "//libc:open",
        "//libc:pipe",
        "//libc:read",
        "//libc:splice",
        "//libc:unlink",
        "//libc:write",
    ],
)

libc_test(
    name = "file_handle_test",
    srcs = ["file_handle_test.cpp"],
    deps = [
        "//libc:close",
        "//libc:fcntl_name_to_handle_at",
        "//libc:fcntl_open_by_handle_at",
        "//libc:hdr_errno_macros",
        "//libc:hdr_fcntl_macros",
        "//libc:hdr_sys_stat_macros",
        "//libc:memcmp",
        "//libc:name_to_handle_at",
        "//libc:open",
        "//libc:open_by_handle_at",
        "//libc:read",
        "//libc:types_struct_file_handle",
        "//libc:unlink",
        "//libc:write",
    ],
)
