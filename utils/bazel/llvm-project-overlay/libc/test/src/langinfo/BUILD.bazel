# Tests for LLVM libc langinfo.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "nl_langinfo_test",
    srcs = ["nl_langinfo_test.cpp"],
    deps = [
        "//libc/hdr/types:locale_t",
        "//libc/hdr:langinfo_macros",
        "//libc/hdr:locale_macros",
        "//libc/src/langinfo:nl_langinfo",
        "//libc/src/langinfo:nl_langinfo_l",
        "//libc/src/locale:locale",
        "//libc/src/locale:locale_data",
    ],
)
