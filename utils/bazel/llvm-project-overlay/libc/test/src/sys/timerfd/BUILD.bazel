# Tests for LLVM libc sys/timerfd.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "timerfd_test",
    srcs = ["timerfd_test.cpp"],
    deps = [
        "//libc/hdr/types:struct_itimerspec",
        "//libc/hdr:errno_macros",
        "//libc/hdr:time_macros",
        "//libc/src/sys/timerfd:sys_timerfd_timerfd_create",
        "//libc/src/sys/timerfd:sys_timerfd_timerfd_gettime",
        "//libc/src/sys/timerfd:sys_timerfd_timerfd_settime",
        "//libc/src/sys/timerfd:timerfd_create",
        "//libc/src/sys/timerfd:timerfd_gettime",
        "//libc/src/sys/timerfd:timerfd_settime",
        "//libc/src/unistd:close",
        "//libc/src/unistd:read",
    ],
)
