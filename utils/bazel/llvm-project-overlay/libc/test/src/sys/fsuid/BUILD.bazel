# Tests for LLVM libc sys/fsuid.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "setfsuid_test",
    srcs = ["setfsuid_test.cpp"],
    deps = [
        "//libc/src/sys/fsuid:setfsgid",
        "//libc/src/sys/fsuid:setfsuid",
        "//libc/src/sys/fsuid:sys_fsuid_setfsgid",
        "//libc/src/sys/fsuid:sys_fsuid_setfsuid",
        "//libc/src/unistd:getgid",
        "//libc/src/unistd:getuid",
    ],
)
