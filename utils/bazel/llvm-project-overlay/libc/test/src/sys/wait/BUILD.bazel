# Tests for LLVM libc sys/wait.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "wait3_test",
    srcs = ["wait3_test.cpp"],
    deps = [
        "//libc:_Exit",
        "//libc:_exit",
        "//libc:fork",
        "//libc:sys_wait_wait3",
        "//libc:types_struct_rusage",
        "//libc:wait3",
    ],
)
