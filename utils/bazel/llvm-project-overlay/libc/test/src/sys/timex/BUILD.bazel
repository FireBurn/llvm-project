# Tests for LLVM libc sys/timex.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "timex_test",
    srcs = ["timex_test.cpp"],
    deps = [
        "//libc:adjtimex",
        "//libc:clock_adjtime",
        "//libc:hdr_errno_macros",
        "//libc:hdr_time_macros",
        "//libc:ntp_adjtime",
    ],
)
