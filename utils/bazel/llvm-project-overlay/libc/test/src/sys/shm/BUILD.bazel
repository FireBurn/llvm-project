# Tests for LLVM libc sys/shm.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "shmat_test",
    srcs = ["linux/shmat_test.cpp"],
    deps = [
        "//libc:__support_cpp_scope",
        "//libc:hdr_errno_macros",
        "//libc:hdr_sys_ipc_macros",
        "//libc:hdr_sys_shm_macros",
        "//libc:hdr_sys_stat_macros",
        "//libc:shmat",
        "//libc:shmctl",
        "//libc:shmdt",
        "//libc:shmget",
    ],
)

libc_test(
    name = "shmctl_test",
    srcs = ["linux/shmctl_test.cpp"],
    deps = [
        "//libc:__support_cpp_scope",
        "//libc:hdr_errno_macros",
        "//libc:hdr_sys_ipc_macros",
        "//libc:hdr_sys_stat_macros",
        "//libc:shmctl",
        "//libc:shmget",
        "//libc:types_struct_shmid_ds",
    ],
)

libc_test(
    name = "shmdt_test",
    srcs = ["linux/shmdt_test.cpp"],
    deps = [
        "//libc:__support_cpp_scope",
        "//libc:hdr_errno_macros",
        "//libc:hdr_sys_ipc_macros",
        "//libc:hdr_sys_shm_macros",
        "//libc:hdr_sys_stat_macros",
        "//libc:shmat",
        "//libc:shmctl",
        "//libc:shmdt",
        "//libc:shmget",
    ],
)

libc_test(
    name = "shmget_test",
    srcs = ["linux/shmget_test.cpp"],
    deps = [
        "//libc:__support_cpp_scope",
        "//libc:hdr_errno_macros",
        "//libc:hdr_sys_ipc_macros",
        "//libc:hdr_sys_stat_macros",
        "//libc:shmctl",
        "//libc:shmget",
    ],
)
