# Tests for LLVM libc sys/time.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "settimeofday_test",
    srcs = ["settimeofday_test.cpp"],
    deps = [
        "//libc/hdr/types:struct_timeval",
        "//libc/hdr/types:struct_timezone",
        "//libc/hdr:errno_macros",
        "//libc/src/sys/time:gettimeofday",
        "//libc/src/sys/time:settimeofday",
    ],
)

libc_test(
    name = "lutimes_test",
    srcs = ["lutimes_test.cpp"],
    deps = [
        "//libc/hdr/types:struct_timeval",
        "//libc/hdr:errno_macros",
        "//libc/hdr:fcntl_macros",
        "//libc/hdr:sys_stat_macros",
        "//libc/src/fcntl:open",
        "//libc/src/sys/stat:lstat",
        "//libc/src/sys/stat:stat",
        "//libc/src/sys/stat:sys_stat_stat",
        "//libc/src/sys/time:lutimes",
        "//libc/src/sys/time:sys_time_lutimes",
        "//libc/src/unistd:close",
        "//libc/src/unistd:symlink",
        "//libc/src/unistd:unlink",
    ],
)
