# Tests for LLVM libc sys/time.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "settimeofday_test",
    srcs = ["settimeofday_test.cpp"],
    deps = [
        "//libc:gettimeofday",
        "//libc:hdr_errno_macros",
        "//libc:settimeofday",
        "//libc:types_struct_timeval",
        "//libc:types_struct_timezone",
    ],
)

libc_test(
    name = "futimes_test",
    srcs = ["futimes_test.cpp"],
    deps = [
        "//libc:close",
        "//libc:fstat",
        "//libc:futimes",
        "//libc:hdr_errno_macros",
        "//libc:hdr_fcntl_macros",
        "//libc:hdr_sys_stat_macros",
        "//libc:open",
        "//libc:sys_time_futimes",
        "//libc:types_struct_timeval",
        "//libc:unlink",
    ],
)

libc_test(
    name = "lutimes_test",
    srcs = ["lutimes_test.cpp"],
    deps = [
        "//libc:close",
        "//libc:hdr_errno_macros",
        "//libc:hdr_fcntl_macros",
        "//libc:hdr_sys_stat_macros",
        "//libc:lutimes",
        "//libc:open",
        "//libc:stat",
        "//libc:symlink",
        "//libc:sys_stat_lstat",
        "//libc:sys_stat_stat",
        "//libc:sys_time_lutimes",
        "//libc:types_struct_timeval",
        "//libc:unlink",
    ],
)
