# Tests for LLVM libc sys/stat.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "statx_test",
    srcs = ["statx_test.cpp"],
    deps = [
        "//libc/hdr/types:mode_t",
        "//libc/hdr/types:struct_statx",
        "//libc/hdr:errno_macros",
        "//libc/hdr:fcntl_macros",
        "//libc/hdr:sys_stat_macros",
        "//libc/src/__support/CPP:scope",
        "//libc/src/fcntl:open",
        "//libc/src/sys/stat:statx",
        "//libc/src/sys/stat:sys_stat_statx",
        "//libc/src/unistd:close",
        "//libc/src/unistd:unlink",
        "//libc/src/unistd:write",
    ],
)

libc_test(
    name = "stat_seccomp_test",
    srcs = ["stat_seccomp_test.cpp"],
    deps = [
        "//libc/hdr/types:struct_stat",
        "//libc/hdr:sys_stat_macros",
        "//libc/src/__support/OSUtil:syscall",
        "//libc/src/stdlib:_Exit",
        "//libc/src/sys/stat:stat",
        "//libc/src/sys/wait:waitpid",
        "//libc/src/unistd:fork",
    ],
)

libc_test(
    name = "stat_test",
    srcs = ["stat_test.cpp"],
    deps = [
        "//libc/hdr/types:struct_stat",
        "//libc/hdr:fcntl_macros",
        "//libc/hdr:sys_stat_macros",
        "//libc/src/fcntl:open",
        "//libc/src/sys/stat:stat",
        "//libc/src/sys/stat:sys_stat_stat",
        "//libc/src/unistd:close",
        "//libc/src/unistd:unlink",
    ],
)
