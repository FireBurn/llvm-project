# Tests for LLVM libc sys/stat.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "statx_test",
    srcs = ["statx_test.cpp"],
    deps = [
        "//libc:close",
        "//libc:hdr_errno_macros",
        "//libc:hdr_fcntl_macros",
        "//libc:hdr_sys_stat_macros",
        "//libc:open",
        "//libc:statx",
        "//libc:sys_stat_statx",
        "//libc:unlink",
        "//libc:write",
    ],
)

libc_test(
    name = "stat_seccomp_test",
    srcs = ["stat_seccomp_test.cpp"],
    deps = [
        "//libc:__support_osutil_syscall",
        "//libc:_Exit",
        "//libc:hdr_sys_stat_macros",
        "//libc:stat",
        "//libc:types_struct_stat",
        "//libc:waitpid",
        "//libc:fork",
    ],
)

libc_test(
    name = "stat_test",
    srcs = ["stat_test.cpp"],
    deps = [
        "//libc:close",
        "//libc:hdr_fcntl_macros",
        "//libc:hdr_sys_stat_macros",
        "//libc:open",
        "//libc:stat",
        "//libc:sys_stat_stat",
        "//libc:types_struct_stat",
        "//libc:unlink",
    ],
)
