# Tests for LLVM libc sys/xattr.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "removexattr_test",
    srcs = ["removexattr_test.cpp"],
    deps = [
        "//libc:__support_cpp_scope",
        "//libc:close",
        "//libc:creat",
        "//libc:fgetxattr",
        "//libc:fremovexattr",
        "//libc:fsetxattr",
        "//libc:getxattr",
        "//libc:hdr_sys_stat_macros",
        "//libc:hdr_sys_xattr_macros",
        "//libc:lremovexattr",
        "//libc:removexattr",
        "//libc:setxattr",
        "//libc:symlink",
        "//libc:sys_xattr_fremovexattr",
        "//libc:sys_xattr_lremovexattr",
        "//libc:sys_xattr_removexattr",
        "//libc:types_size_t",
        "//libc:types_ssize_t",
        "//libc:unlink",
    ],
)
