# Tests for LLVM libc sys/uio.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "pvec_test",
    srcs = ["pvec_test.cpp"],
    deps = [
        "//libc:close",
        "//libc:hdr_errno_macros",
        "//libc:hdr_fcntl_macros",
        "//libc:hdr_stdio_macros",
        "//libc:hdr_sys_stat_macros",
        "//libc:lseek",
        "//libc:memcmp",
        "//libc:open",
        "//libc:preadv",
        "//libc:pwritev",
        "//libc:sys_uio_preadv",
        "//libc:sys_uio_pwritev",
        "//libc:types_struct_iovec",
        "//libc:unlink",
    ],
)
