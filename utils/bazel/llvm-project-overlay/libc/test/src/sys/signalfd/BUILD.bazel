# Tests for LLVM libc sys/signalfd.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "signalfd_test",
    srcs = ["signalfd_test.cpp"],
    deps = [
        "//libc:close",
        "//libc:getpid",
        "//libc:hdr_errno_macros",
        "//libc:hdr_signal_macros",
        "//libc:kill",
        "//libc:read",
        "//libc:sigaddset",
        "//libc:sigemptyset",
        "//libc:signalfd",
        "//libc:sigprocmask",
        "//libc:sys_signalfd_signalfd",
        "//libc:types_sigset_t",
    ],
)
