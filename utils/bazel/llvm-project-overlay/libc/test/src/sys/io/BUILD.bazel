# Tests for LLVM libc sys/io.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "io_test",
    srcs = ["io_test.cpp"],
    deps = [
        "//libc:geteuid",
        "//libc:hdr_errno_macros",
        "//libc:ioperm",
        "//libc:iopl",
        "//libc:sys_io_ioperm",
        "//libc:sys_io_iopl",
    ],
)
