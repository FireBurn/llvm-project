# Tests for LLVM libc __support/elf functionality.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "dynamic_test",
    srcs = ["dynamic_test.cpp"],
    deps = [
        "//libc:__support_elf_dynamic",
        "//libc:__support_elf_elf_types",
    ],
)

libc_test(
    name = "hash_test",
    srcs = ["hash_test.cpp"],
    deps = [
        "//libc:__support_elf_hash",
    ],
)

libc_test(
    name = "symbol_test",
    srcs = ["symbol_test.cpp"],
    deps = [
        "//libc:__support_elf_symbol",
    ],
)

libc_test(
    name = "relocation_test",
    srcs = ["relocation_test.cpp"],
    deps = [
        "//libc:__support_elf_elf_types",
        "//libc:__support_elf_relocation",
    ],
)

libc_test(
    name = "module_test",
    srcs = ["module_test.cpp"],
    deps = [
        "//libc:__support_elf_elf_types",
        "//libc:__support_elf_module",
    ],
)

libc_test(
    name = "relr_test",
    srcs = ["relr_test.cpp"],
    deps = [
        "//libc:__support_elf_relocation",
    ],
)

libc_test(
    name = "tls_layout_test",
    srcs = ["tls_layout_test.cpp"],
    deps = [
        "//libc:__support_elf_tls_layout",
    ],
)

libc_test(
    name = "load_layout_test",
    srcs = ["load_layout_test.cpp"],
    deps = [
        "//libc:__support_elf_elf_types",
        "//libc:__support_elf_load_layout",
    ],
)

libc_test(
    name = "map_segments_test",
    srcs = ["map_segments_test.cpp"],
    deps = [
        "//libc:__support_c_string",
        "//libc:__support_elf_elf_types",
        "//libc:__support_elf_map_segments",
        "//libc:__support_osutil_linux_syscall_wrappers_close",
        "//libc:__support_osutil_linux_syscall_wrappers_open",
        "//libc:__support_osutil_linux_syscall_wrappers_write",
        "//libc:hdr_fcntl_macros",
    ],
)

libc_test(
    name = "startup_stack_test",
    srcs = ["startup_stack_test.cpp"],
    deps = [
        "//libc:__support_elf_startup_stack",
    ],
)

libc_test(
    name = "run_path_test",
    srcs = ["run_path_test.cpp"],
    deps = [
        "//libc:__support_cpp_string_view",
        "//libc:__support_elf_run_path",
    ],
)

libc_test(
    name = "search_paths_test",
    srcs = ["search_paths_test.cpp"],
    deps = [
        "//libc:__support_elf_search",
        "//libc:close",
        "//libc:hdr_fcntl_macros",
        "//libc:hdr_sys_stat_macros",
        "//libc:open",
        "//libc:unlink",
        "//libc:write",
    ],
)
