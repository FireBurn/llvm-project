# Tests for LLVM libc __support/elf functionality.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "dynamic_test",
    srcs = ["dynamic_test.cpp"],
    deps = [
        "//libc/src/__support:elf_dynamic",
        "//libc/src/__support:elf_elf_types",
    ],
)

libc_test(
    name = "hash_test",
    srcs = ["hash_test.cpp"],
    deps = [
        "//libc/src/__support:elf_hash",
    ],
)

libc_test(
    name = "symbol_test",
    srcs = ["symbol_test.cpp"],
    deps = [
        "//libc/src/__support:elf_symbol",
    ],
)

libc_test(
    name = "relocation_test",
    srcs = ["relocation_test.cpp"],
    deps = [
        "//libc/src/__support:elf_elf_types",
        "//libc/src/__support:elf_relocation",
    ],
)

libc_test(
    name = "module_test",
    srcs = ["module_test.cpp"],
    deps = [
        "//libc/src/__support:elf_elf_types",
        "//libc/src/__support:elf_module",
    ],
)

libc_test(
    name = "tls_layout_test",
    srcs = ["tls_layout_test.cpp"],
    deps = [
        "//libc/src/__support:elf_tls_layout",
    ],
)

libc_test(
    name = "load_layout_test",
    srcs = ["load_layout_test.cpp"],
    deps = [
        "//libc/src/__support:elf_elf_types",
        "//libc/src/__support:elf_load_layout",
    ],
)

libc_test(
    name = "map_segments_test",
    srcs = ["map_segments_test.cpp"],
    deps = [
        "//libc/hdr:fcntl_macros",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:close",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:open",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:write",
        "//libc/src/__support:c_string",
        "//libc/src/__support:elf_elf_types",
        "//libc/src/__support:elf_map_segments",
    ],
)
