# Tests for LLVM libc __support/elf functionality.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "dynamic_test",
    srcs = ["dynamic_test.cpp"],
    deps = [
        "//libc:__support_elf_dynamic",
        "//libc:__support_elf_elf_types",
    ],
)

libc_test(
    name = "hash_test",
    srcs = ["hash_test.cpp"],
    deps = [
        "//libc:__support_elf_hash",
    ],
)

libc_test(
    name = "symbol_test",
    srcs = ["symbol_test.cpp"],
    deps = [
        "//libc:__support_elf_symbol",
    ],
)

libc_test(
    name = "relocation_test",
    srcs = ["relocation_test.cpp"],
    deps = [
        "//libc:__support_elf_elf_types",
        "//libc:__support_elf_relocation",
    ],
)

libc_test(
    name = "module_test",
    srcs = ["module_test.cpp"],
    deps = [
        "//libc:__support_elf_elf_types",
        "//libc:__support_elf_module",
    ],
)

libc_test(
    name = "tls_layout_test",
    srcs = ["tls_layout_test.cpp"],
    deps = [
        "//libc:__support_elf_tls_layout",
    ],
)
