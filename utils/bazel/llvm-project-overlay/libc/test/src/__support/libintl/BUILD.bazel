# Tests for LLVM libc __support/libintl.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "plural_test",
    srcs = ["plural_test.cpp"],
    deps = [
        "//libc:__support_cpp_string_view",
        "//libc:__support_libintl_plural",
    ],
)

libc_test(
    name = "catalog_test",
    srcs = ["catalog_test.cpp"],
    deps = [
        "//libc:__support_libintl_catalog",
    ],
)
