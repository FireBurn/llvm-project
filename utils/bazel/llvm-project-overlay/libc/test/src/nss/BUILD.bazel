        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/File:line_reader",
        "//libc/src/__support:nss_config",
        "//libc/src/__support:nss_module",
        "//libc/src/grp:getgrgid",
        "//libc/src/grp:getgrnam",
        "//libc/src/grp:getgrouplist",
