# Tests for LLVM libc resolv.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "dn_expand_test",
    srcs = ["dn_expand_test.cpp"],
    deps = [
        "//libc:dn_comp",
        "//libc:dn_expand",
        "//libc:string_memory_utils",
    ],
)

libc_test(
    name = "res_query_test",
    srcs = ["res_query_test.cpp"],
    deps = [
        "//libc:__res_state",
        "//libc:netdb_resolv_dns_message",
        "//libc:res_close",
        "//libc:res_init",
        "//libc:res_mkquery",
        "//libc:res_query",
        "//libc:res_search",
        "//libc:res_send",
        "//libc:types_struct___res_state",
    ],
)

libc_test(
    name = "res_init_test",
    srcs = ["res_init_test.cpp"],
    deps = ["//libc:res_init"],
)
