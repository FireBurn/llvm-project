# Tests for LLVM libc uchar.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "mbrtoc32_test",
    srcs = ["mbrtoc32_test.cpp"],
    deps = [
        "//libc/test/UnitTest:Utf8Locale",
        "//libc:c32rtomb",
        "//libc:mbrtoc32",
        "//libc:types_char32_t",
        "//libc:types_mbstate_t",
    ],
)

libc_test(
    name = "mbrtoc16_test",
    srcs = ["mbrtoc16_test.cpp"],
    deps = [
        "//libc/test/UnitTest:Utf8Locale",
        "//libc:c16rtomb",
        "//libc:mbrtoc16",
        "//libc:types_char16_t",
        "//libc:types_mbstate_t",
    ],
)
