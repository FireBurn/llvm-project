load("//libc:libc_build_rules.bzl", "libc_function", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_support_library(
    name = "fts_walk",
    hdrs = ["fts_walk.h"],
    deps = [
        "//libc/hdr/func:free",
        "//libc/hdr/func:malloc",
        "//libc/hdr/types:DIR",
        "//libc/hdr/types:FTS",
        "//libc/hdr/types:FTSENT",
        "//libc/hdr/types:struct_dirent",
        "//libc/hdr/types:struct_stat",
        "//libc/hdr:errno_macros",
        "//libc/hdr:fcntl_macros",
        "//libc/hdr:fts_macros",
        "//libc/hdr:limits_macros",
        "//libc/hdr:sys_stat_macros",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:libc_errno",
        "//libc/src/ftw:ftw_walk",
        "//libc/src/string/memory_utils:memory_utils",
        "//libc/src/string:utils",
    ],
)

libc_function(
    name = "children",
    srcs = ["fts_children.cpp"],
    hdrs = ["fts_children.h"],
    deps = [
        ":fts_walk",
        "//libc/hdr/types:FTS",
        "//libc/hdr/types:FTSENT",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)

libc_function(
    name = "close",
    srcs = ["fts_close.cpp"],
    hdrs = ["fts_close.h"],
    deps = [
        ":fts_walk",
        "//libc/hdr/types:FTS",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)

libc_function(
    name = "open",
    srcs = ["fts_open.cpp"],
    hdrs = ["fts_open.h"],
    deps = [
        ":fts_walk",
        "//libc/hdr/types:FTS",
        "//libc/hdr/types:__fts_compare_func_t",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)

libc_function(
    name = "read",
    srcs = ["fts_read.cpp"],
    hdrs = ["fts_read.h"],
    deps = [
        ":fts_walk",
        "//libc/hdr/types:FTS",
        "//libc/hdr/types:FTSENT",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)

libc_function(
    name = "set",
    srcs = ["fts_set.cpp"],
    hdrs = ["fts_set.h"],
    deps = [
        "//libc/hdr/types:FTS",
        "//libc/hdr/types:FTSENT",
        "//libc/hdr:errno_macros",
        "//libc/hdr:fts_macros",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
    ],
)
