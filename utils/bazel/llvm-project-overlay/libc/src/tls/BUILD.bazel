load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "__tls_get_addr",
    srcs = ["tls_get_addr.cpp"],
    hdrs = ["tls_get_addr.h"],
    deps = [
        "//libc/hdr/types:size_t",
        "//libc/hdr:stdint_proxy",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/__support:elf_passive_abi",
        "//libc/src/__support:elf_thread_pointer",
    ],
)
