    hdrs = ["setmntent.h"],
    deps = [
        "//libc/hdr/types:FILE",
        "//libc/hdr/types:struct_mntent",
        "//libc/src/__support/File:file",
        "//libc/src/__support/File:platform_file",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/errno:errno",
    ],
)

libc_function(
    name = "endmntent",
