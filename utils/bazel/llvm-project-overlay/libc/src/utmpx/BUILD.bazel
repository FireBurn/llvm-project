load("//libc:libc_build_rules.bzl", "libc_function", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_support_library(
    name = "utmpx_db",
    srcs = ["utmpx_db.cpp"],
    hdrs = ["utmpx_db.h"],
    deps = [
        "//libc/hdr/types:struct_utmpx",
        "//libc/hdr:fcntl_macros",
        "//libc/hdr:stdio_macros",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:close",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:lseek",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:openat",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:read",
        "//libc/src/__support/macros:config",
    ],
)

libc_function(
    name = "setutxent",
    srcs = ["setutxent.cpp"],
    hdrs = ["setutxent.h"],
    deps = [
        ":utmpx_db",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)

libc_function(
    name = "endutxent",
