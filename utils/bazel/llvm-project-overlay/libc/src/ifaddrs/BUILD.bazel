load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "getifaddrs",
    srcs = ["linux/getifaddrs.cpp"],
    hdrs = ["getifaddrs.h"],
    deps = [
        "//libc/hdr/func:free",
        "//libc/hdr/func:malloc",
        "//libc/hdr/types:socklen_t",
        "//libc/hdr/types:ssize_t",
        "//libc/hdr/types:struct_ifaddrs",
        "//libc/hdr/types:struct_sockaddr",
        "//libc/hdr/types:struct_sockaddr_in",
        "//libc/hdr/types:struct_sockaddr_in6",
        "//libc/hdr:errno_macros",
        "//libc/hdr:net_if_macros",
        "//libc/hdr:sys_socket_macros",
        "//libc/src/__support/CPP:scope",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:close",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:recvfrom",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:sendto",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:socket",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/string/memory_utils:memory_utils",
        "//libc/src/string:utils",
    ],
)

libc_function(
    name = "freeifaddrs",
    srcs = ["linux/freeifaddrs.cpp"],
    hdrs = ["freeifaddrs.h"],
    deps = [
        "//libc/hdr/func:free",
        "//libc/hdr/types:struct_ifaddrs",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)
