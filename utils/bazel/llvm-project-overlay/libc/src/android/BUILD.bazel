load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "get_application_target_sdk_version",
    srcs = ["android_get_application_target_sdk_version.cpp"],
    hdrs = ["android_get_application_target_sdk_version.h"],
    deps = [
        "//libc/hdr:android_api_level_macros",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)
