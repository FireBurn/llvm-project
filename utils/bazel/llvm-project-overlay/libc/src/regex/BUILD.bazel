load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "regcomp",
    srcs = ["regcomp.cpp"],
    hdrs = ["regcomp.h", "regex_engine.h", "regex_parser.h"],
    deps = [
        "//libc/hdr/func:free",
        "//libc/hdr/func:malloc",
        "//libc/hdr/types:regex_t",
        "//libc/hdr/types:size_t",
        "//libc/hdr:regex_macros",
        "//libc/hdr:stdint_proxy",
        "//libc/src/__support/CPP:optional",
        "//libc/src/__support/macros:attributes",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/macros:null_check",
        "//libc/src/__support:common",
        "//libc/src/__support:ctype_utils",
    ],
)

libc_function(
    name = "regexec",
    srcs = ["regexec.cpp"],
    hdrs = ["regex_engine.h", "regex_matcher.h", "regexec.h"],
    deps = [
        ":regcomp",
        "//libc/hdr/types:regex_t",
        "//libc/hdr/types:regmatch_t",
        "//libc/hdr/types:size_t",
        "//libc/hdr:limits_macros",
        "//libc/hdr:regex_macros",
        "//libc/hdr:stdint_proxy",
        "//libc/src/__support/CPP:optional",
        "//libc/src/__support/macros:attributes",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/macros:null_check",
        "//libc/src/__support:common",
        "//libc/src/__support:ctype_utils",
        "//libc/src/string:utils",
    ],
)

libc_function(
    name = "regfree",
    srcs = ["regfree.cpp"],
    hdrs = ["regfree.h"],
    deps = [
        "//libc/hdr/func:free",
        "//libc/hdr/types:regex_t",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/macros:null_check",
        "//libc/src/__support:common",
    ],
)
