load("//libc:libc_build_rules.bzl", "libc_function", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_support_library(
    name = "locale",
    srcs = ["locale.cpp"],
    hdrs = ["locale.h"],
    deps = [
        ":locale_data",
        "//libc/config:app_h",
        "//libc/hdr/types:locale_t",
        "//libc/hdr:locale_macros",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/macros:attributes",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/__support:ctype_utils",
        "//libc/src/stdlib:mb_cur_max",
    ],
)

libc_function(
    name = "newlocale",
    srcs = ["newlocale.cpp"],
    hdrs = ["newlocale.h"],
    deps = [
        ":locale",
        "//libc/hdr/types:locale_t",
        "//libc/hdr:locale_macros",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
    ],
)

libc_function(
    name = "setlocale",
    srcs = ["setlocale.cpp"],
    hdrs = ["setlocale.h"],
    deps = [
        ":locale",
        ":locale_data",
        "//libc/hdr/types:locale_t",
        "//libc/hdr:locale_macros",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)

libc_function(
    name = "uselocale",
    srcs = ["uselocale.cpp"],
    hdrs = ["uselocale.h"],
    deps = [
        ":locale",
        ":locale_data",
        "//libc/hdr/types:locale_t",
        "//libc/hdr:locale_macros",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)

libc_function(
    name = "freelocale",
    srcs = ["freelocale.cpp"],
    hdrs = ["freelocale.h"],
    deps = [
        "//libc/hdr/types:locale_t",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)

libc_support_library(
    name = "locale_data",
    hdrs = ["locale_data.h"],
    deps = [
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/macros:attributes",
        "//libc/src/__support/macros:config",
    ],
)
