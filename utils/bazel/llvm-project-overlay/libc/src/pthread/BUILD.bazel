load("//libc:libc_build_rules.bzl", "libc_function", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_support_library(
    name = "pthread_attr",
    hdrs = ["pthread_attr.h"],
    deps = [
        "//libc/hdr/types:pthread_attr_t",
        "//libc/hdr:pthread_macros",
        "//libc/hdr:sched_macros",
        "//libc/src/__support/macros:attributes",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/threads:thread",
        "//libc/src/__support/threads:thread_headers",
    ],
)

libc_function(
    name = "create",
    srcs = ["pthread_create.cpp"],
    hdrs = ["pthread_create.h"],
    deps = [
        ":pthread_attr",
        "//libc/hdr/types:pthread_attr_t",
        "//libc/hdr/types:pthread_t",
        "//libc/hdr:errno_macros",
        "//libc/hdr:pthread_macros",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/threads:thread",
        "//libc/src/__support/threads:thread_headers",
        "//libc/src/__support:common",
    ],
)

libc_function(
    name = "join",
    srcs = ["pthread_join.cpp"],
    hdrs = ["pthread_join.h"],
    deps = [
        "//libc/src/__support/macros:config",
        "//libc/src/__support/threads:thread",
        "//libc/src/__support/threads:thread_headers",
        "//libc/src/__support:common",
    ],
)

libc_function(
    name = "cancel",
    srcs = ["pthread_cancel.cpp"],
    hdrs = ["pthread_cancel.h"],
    deps = [
        "//libc/hdr/types:struct_sigaction",
        "//libc/hdr:errno_macros",
        "//libc/hdr:signal_macros",
        "//libc/src/__support/CPP:atomic",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:getpid",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:tgkill",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/threads:cancel",
        "//libc/src/__support/threads:thread",
        "//libc/src/__support/threads:thread_headers",
        "//libc/src/__support:common",
        "//libc/src/signal:__signal_utils",
    ],
)

libc_function(
    name = "setcancelstate",
    srcs = ["pthread_setcancelstate.cpp"],
    hdrs = ["pthread_setcancelstate.h"],
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/threads:cancel",
        "//libc/src/__support/threads:thread",
        "//libc/src/__support/threads:thread_headers",
        "//libc/src/__support:common",
    ],
)

libc_function(
    name = "setcanceltype",
    srcs = ["pthread_setcanceltype.cpp"],
    hdrs = ["pthread_setcanceltype.h"],
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/threads:cancel",
        "//libc/src/__support/threads:thread",
        "//libc/src/__support/threads:thread_headers",
        "//libc/src/__support:common",
    ],
)

libc_function(
    name = "testcancel",
    srcs = ["pthread_testcancel.cpp"],
    hdrs = ["pthread_testcancel.h"],
    deps = [
        "//libc/src/__support/macros:config",
        "//libc/src/__support/threads:cancel",
        "//libc/src/__support:common",
    ],
)

libc_function(
    name = "__pthread_cleanup_pop",
    srcs = ["__pthread_cleanup_pop.cpp"],
    hdrs = ["__pthread_cleanup_pop.h"],
    deps = [
        "//libc/hdr/types:struct___pthread_cleanup_frame",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/threads:thread",
        "//libc/src/__support/threads:thread_headers",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_assert",
    ],
)

libc_function(
    name = "__pthread_cleanup_push",
    srcs = ["__pthread_cleanup_push.cpp"],
    hdrs = ["__pthread_cleanup_push.h"],
    deps = [
        "//libc/hdr/types:struct___pthread_cleanup_frame",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/macros:null_check",
        "//libc/src/__support/threads:thread",
        "//libc/src/__support/threads:thread_headers",
        "//libc/src/__support:common",
    ],
)
