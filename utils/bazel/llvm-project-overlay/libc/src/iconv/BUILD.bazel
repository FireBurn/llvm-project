load("//libc:libc_build_rules.bzl", "libc_function", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_support_library(
    name = "sequences",
    hdrs = ["sequences.h"],
    deps = [
        "//libc/hdr/types:char32_t",
        "//libc/hdr/types:size_t",
        "//libc/hdr:stdint_proxy",
        "//libc/src/__support/macros:attributes",
        "//libc/src/__support/macros:config",
    ],
)

libc_support_library(
    name = "cjk_tables",
    srcs = ["cjk_tables.cpp"],
    hdrs = ["cjk_tables.h", "code_table.h"],
    deps = [
        ":sequences",
        "//libc/hdr/types:char32_t",
        "//libc/hdr/types:size_t",
        "//libc/hdr:stdint_proxy",
        "//libc/src/__support/macros:attributes",
        "//libc/src/__support/macros:config",
    ],
)

libc_support_library(
    name = "charsets",
    hdrs = ["charsets.h", "combining.h", "single_byte_tables.h"],
    deps = [
        ":cjk_tables",
        ":sequences",
        "//libc/hdr/types:char32_t",
        "//libc/hdr/types:size_t",
        "//libc/hdr:stdint_proxy",
        "//libc/src/__support/macros:attributes",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)

libc_support_library(
    name = "conversion",
    hdrs = ["conversion.h", "japanese.h", "status.h"],
    deps = [
        ":charsets",
        ":cjk_tables",
        ":sequences",
        "//libc/hdr/types:char32_t",
        "//libc/hdr/types:size_t",
        "//libc/hdr:errno_macros",
        "//libc/hdr:stdint_proxy",
        "//libc/src/__support/macros:attributes",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/__support:ctype_utils",
    ],
)

libc_function(
    name = "open",
    srcs = ["iconv_open.cpp"],
    hdrs = ["iconv_open.h"],
    deps = [
        ":conversion",
        "//libc/hdr/func:malloc",
        "//libc/hdr/types:iconv_t",
        "//libc/hdr/types:size_t",
        "//libc/hdr:errno_macros",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/errno:errno",
        "//libc/src/locale:locale",
        "//libc/src/locale:locale_data",
    ],
)

libc_function(
    name = "iconv",
    srcs = ["iconv.cpp"],
    hdrs = ["iconv.h"],
    deps = [
        ":conversion",
        "//libc/hdr/types:char32_t",
        "//libc/hdr/types:iconv_t",
        "//libc/hdr/types:size_t",
        "//libc/hdr:errno_macros",
        "//libc/hdr:stdint_proxy",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/errno:errno",
    ],
)

libc_function(
    name = "close",
    srcs = ["iconv_close.cpp"],
    hdrs = ["iconv_close.h"],
    deps = [
        ":conversion",
        "//libc/hdr/func:free",
        "//libc/hdr/types:iconv_t",
        "//libc/hdr/types:size_t",
        "//libc/hdr:errno_macros",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/errno:errno",
    ],
)
