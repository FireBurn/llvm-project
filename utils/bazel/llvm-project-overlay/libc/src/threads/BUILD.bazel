load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "thrd_current",
    srcs = ["thrd_current.cpp"],
    hdrs = ["thrd_current.h"],
    deps = [
        "//libc/src/__support/macros:config",
        "//libc/src/__support/threads:thread",
        "//libc/src/__support/threads:thread_headers",
        "//libc/src/__support:common",
    ],
)
