load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "thrd_current",
    srcs = ["thrd_current.cpp"],
    hdrs = ["thrd_current.h"],
    deps = [
        "//libc/src/__support/macros:config",
        "//libc/src/__support/threads:thread",
        "//libc/src/__support/threads:thread_headers",
        "//libc/src/__support:common",
    ],
)

libc_function(
    name = "mtx_init",
    srcs = ["mtx_init.cpp"],
    hdrs = ["mtx_init.h"],
    deps = [
        "//libc/src/__support/CPP:new",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/threads:mutex",
        "//libc/src/__support:common",
    ],
)

libc_function(
    name = "cnd_init",
    srcs = ["linux/cnd_init.cpp"],
    hdrs = ["cnd_init.h"],
    deps = [
        "//libc/src/__support/CPP:new",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/threads:cndvar",
        "//libc/src/__support:common",
    ],
)

libc_function(
    name = "cnd_destroy",
    srcs = ["linux/cnd_destroy.cpp"],
    hdrs = ["cnd_destroy.h"],
    deps = [
        "//libc/src/__support/macros:config",
        "//libc/src/__support/threads:cndvar",
        "//libc/src/__support:common",
    ],
)

libc_function(
    name = "cnd_wait",
