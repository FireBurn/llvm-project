load("//libc:libc_build_rules.bzl", "libc_function", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_support_library(
    name = "ftw_walk",
    hdrs = ["ftw_walk.h"],
    deps = [
        "//libc/hdr/func:free",
        "//libc/hdr/func:malloc",
        "//libc/hdr/func:realloc",
        "//libc/hdr/types:DIR",
        "//libc/hdr/types:__ftw_func_t",
        "//libc/hdr/types:__nftw_func_t",
        "//libc/hdr/types:struct_FTW",
        "//libc/hdr/types:struct_dirent",
        "//libc/hdr/types:struct_stat",
        "//libc/hdr:errno_macros",
        "//libc/hdr:fcntl_macros",
        "//libc/hdr:ftw_macros",
        "//libc/hdr:limits_macros",
        "//libc/hdr:sys_stat_macros",
        "//libc/src/__support/File:dir",
        "//libc/src/__support/OSUtil:linux_stat_stat_via_statx",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:error_or",
        "//libc/src/__support:libc_errno",
        "//libc/src/string/memory_utils:memory_utils",
        "//libc/src/string:utils",
    ],
)

libc_function(
    name = "ftw",
    srcs = ["ftw.cpp"],
    hdrs = ["ftw.h"],
    deps = [
        ":ftw_walk",
        "//libc/hdr/types:__ftw_func_t",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)

libc_function(
    name = "nftw",
    srcs = ["nftw.cpp"],
    hdrs = ["nftw.h"],
    deps = [
        ":ftw_walk",
        "//libc/hdr/types:__nftw_func_t",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)
