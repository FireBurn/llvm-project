load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "__xpg_strerror_r",
    srcs = ["__xpg_strerror_r.cpp"],
    hdrs = ["__xpg_strerror_r.h"],
    deps = [
        "//libc/hdr/types:size_t",
        "//libc/hdr:errno_macros",
        "//libc/src/__support/StringUtil:StringUtil",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/string/memory_utils:memory_utils",
    ],
)

libc_function(
    name = "gnu_get_libc_version",
