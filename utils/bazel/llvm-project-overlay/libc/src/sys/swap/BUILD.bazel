load("//libc:libc_build_rules.bzl", "libc_function", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "swapoff",
    srcs = ["linux/swapoff.cpp"],
    hdrs = ["swapoff.h"],
    deps = [
        ":sys_swap_swapoff",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:swapoff",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/__support:error_or",
        "//libc/src/__support:libc_errno",
        "//libc/src/errno:errno",
    ],
)

libc_function(
    name = "swapon",
    srcs = ["linux/swapon.cpp"],
    hdrs = ["swapon.h"],
    deps = [
        ":sys_swap_swapon",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:swapon",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/__support:error_or",
        "//libc/src/__support:libc_errno",
        "//libc/src/errno:errno",
    ],
)

libc_support_library(
    name = "sys_swap_swapoff",
    hdrs = ["swapoff.h"],
    deps = [
        "//libc/src/__support/macros:config",
    ],
)

libc_support_library(
    name = "sys_swap_swapon",
    hdrs = ["swapon.h"],
    deps = [
        "//libc/src/__support/macros:config",
    ],
)
