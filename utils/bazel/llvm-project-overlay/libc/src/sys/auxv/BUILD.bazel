load("//libc:libc_build_rules.bzl", "libc_function", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_support_library(
    name = "linux_set_auxv",
    srcs = ["linux/set_auxv.cpp"],
    hdrs = ["linux/set_auxv.h"],
    deps = [
        "//libc/src/__support/OSUtil:linux_auxv",
        "//libc/src/__support/macros:config",
    ],
)

libc_function(
    name = "getauxval",
    srcs = ["linux/getauxval.cpp"],
    hdrs = ["getauxval.h"],
    deps = [
        "//libc/hdr:sys_auxv_macros",
        "//libc/src/__support/OSUtil:linux_auxv",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:libc_errno",
    ],
)
