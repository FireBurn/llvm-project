load("//libc:libc_build_rules.bzl", "libc_function", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "mkdir",
    srcs = ["linux/mkdir.cpp"],
    hdrs = ["mkdir.h"],
    deps = [
        "//libc/hdr/types:mode_t",
        "//libc/hdr:fcntl_macros",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:mkdir",
        "//libc/src/__support/OSUtil:syscall",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/errno",
    ],
)

libc_function(
    name = "mkdirat",
    srcs = ["linux/mkdirat.cpp"],
    hdrs = ["mkdirat.h"],
    deps = [
        "//libc/hdr/types:mode_t",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:mkdirat",
        "//libc/src/__support/OSUtil:syscall",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/errno",
    ],
)

libc_function(
    name = "stat",
    srcs = ["linux/stat.cpp"],
    hdrs = ["stat.h"],
    deps = [
        ":sys_stat_stat",
        "//libc/hdr/types:struct_stat",
        "//libc/hdr:fcntl_macros",
        "//libc/src/__support/OSUtil:linux_stat_stat_via_statx",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/__support:error_or",
        "//libc/src/__support:libc_errno",
    ],
)

libc_function(
    name = "statx",
    srcs = ["linux/statx.cpp"],
    hdrs = ["statx.h"],
    deps = [
        ":sys_stat_statx",
        "//libc/hdr/types:struct_statx",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:statx",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/errno:errno",
    ],
)

libc_support_library(
    name = "sys_stat_statx",
    hdrs = ["statx.h"],
    deps = [
        "//libc/hdr/types:struct_statx",
        "//libc/src/__support/macros:config",
