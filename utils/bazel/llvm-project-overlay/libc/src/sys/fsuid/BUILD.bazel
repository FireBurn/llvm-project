load("//libc:libc_build_rules.bzl", "libc_function", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "setfsgid",
    srcs = ["linux/setfsgid.cpp"],
    hdrs = ["setfsgid.h"],
    deps = [
        ":sys_fsuid_setfsgid",
        "//libc/hdr/types:gid_t",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:setfsgid",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)

libc_function(
    name = "setfsuid",
    srcs = ["linux/setfsuid.cpp"],
    hdrs = ["setfsuid.h"],
    deps = [
        ":sys_fsuid_setfsuid",
        "//libc/hdr/types:uid_t",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:setfsuid",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)

libc_support_library(
    name = "sys_fsuid_setfsgid",
    hdrs = ["setfsgid.h"],
    deps = [
        "//libc/hdr/types:gid_t",
        "//libc/src/__support/macros:config",
    ],
)

libc_support_library(
    name = "sys_fsuid_setfsuid",
    hdrs = ["setfsuid.h"],
    deps = [
        "//libc/hdr/types:uid_t",
        "//libc/src/__support/macros:config",
    ],
)
