load("//libc:libc_build_rules.bzl", "libc_function", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "ioperm",
    srcs = ["linux/ioperm.cpp"],
    hdrs = ["ioperm.h"],
    deps = [
        ":sys_io_ioperm",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:ioperm",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/errno:errno",
    ],
)

libc_function(
    name = "iopl",
    srcs = ["linux/iopl.cpp"],
    hdrs = ["iopl.h"],
    deps = [
        ":sys_io_iopl",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:iopl",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/errno:errno",
    ],
)

libc_support_library(
    name = "sys_io_ioperm",
    hdrs = ["ioperm.h"],
    deps = [
        "//libc/src/__support/macros:config",
    ],
)

libc_support_library(
    name = "sys_io_iopl",
    hdrs = ["iopl.h"],
    deps = [
        "//libc/src/__support/macros:config",
    ],
)
