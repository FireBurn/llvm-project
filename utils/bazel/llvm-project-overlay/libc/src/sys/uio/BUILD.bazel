load("//libc:libc_build_rules.bzl", "libc_function", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "readv",
    srcs = ["linux/readv.cpp"],
    hdrs = ["readv.h"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libc/hdr/types:ssize_t",
        "//libc/hdr/types:struct_iovec",
        "//libc/hdr:errno_macros",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:readv",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/threads:cancel",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/errno",
    ],
)

libc_function(
    name = "writev",
    srcs = ["linux/writev.cpp"],
    hdrs = ["writev.h"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libc/hdr/types:ssize_t",
        "//libc/hdr/types:struct_iovec",
        "//libc/hdr:errno_macros",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:writev",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/threads:cancel",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/errno",
    ],
)

libc_function(
    name = "preadv",
    srcs = ["linux/preadv.cpp"],
    hdrs = ["preadv.h"],
    deps = [
        ":sys_uio_preadv",
        "//libc/hdr/types:off_t",
        "//libc/hdr/types:ssize_t",
        "//libc/hdr/types:struct_iovec",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:preadv",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/errno:errno",
    ],
)

libc_function(
    name = "pwritev",
    srcs = ["linux/pwritev.cpp"],
    hdrs = ["pwritev.h"],
    deps = [
        ":sys_uio_pwritev",
        "//libc/hdr/types:off_t",
        "//libc/hdr/types:ssize_t",
        "//libc/hdr/types:struct_iovec",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:pwritev",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/errno:errno",
    ],
)

libc_support_library(
    name = "sys_uio_preadv",
    hdrs = ["preadv.h"],
    deps = [
        "//libc/hdr/types:off_t",
        "//libc/hdr/types:ssize_t",
        "//libc/hdr/types:struct_iovec",
        "//libc/src/__support/macros:config",
    ],
)

libc_support_library(
    name = "sys_uio_pwritev",
    hdrs = ["pwritev.h"],
    deps = [
        "//libc/hdr/types:off_t",
        "//libc/hdr/types:ssize_t",
        "//libc/hdr/types:struct_iovec",
        "//libc/src/__support/macros:config",
    ],
)
