load("//libc:libc_build_rules.bzl", "libc_function", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "signalfd",
    srcs = ["linux/signalfd.cpp"],
    hdrs = ["signalfd.h"],
    deps = [
        ":sys_signalfd_signalfd",
        "//libc/hdr/types:sigset_t",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:signalfd",
        "//libc/src/__support/OSUtil:syscall",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/errno:errno",
    ],
)

libc_support_library(
    name = "sys_signalfd_signalfd",
    hdrs = ["signalfd.h"],
    deps = [
        "//libc/hdr/types:sigset_t",
        "//libc/src/__support/macros:config",
    ],
)
