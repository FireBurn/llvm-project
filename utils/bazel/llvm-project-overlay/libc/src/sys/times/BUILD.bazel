load("//libc:libc_build_rules.bzl", "libc_function", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "times",
    srcs = ["linux/times.cpp"],
    hdrs = ["times.h"],
    deps = [
        ":sys_times_times",
        "//libc/hdr/types:clock_t",
        "//libc/hdr/types:struct_tms",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:times",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
    ],
)

libc_support_library(
    name = "sys_times_times",
    hdrs = ["times.h"],
    deps = [
        "//libc/hdr/types:clock_t",
        "//libc/hdr/types:struct_tms",
        "//libc/src/__support/macros:config",
    ],
)
