load("//libc:libc_build_rules.bzl", "libc_function", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "get_nprocs",
    srcs = ["linux/get_nprocs.cpp"],
    hdrs = ["get_nprocs.h"],
    deps = [
        ":sys_sysinfo_get_nprocs",
        "//libc/hdr/types:cpu_set_t",
        "//libc/src/__support/CPP:span",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:sched_getaffinity",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/sched:sched_getcpucount",
    ],
)

libc_function(
    name = "get_nprocs_conf",
    srcs = ["linux/get_nprocs_conf.cpp"],
    hdrs = ["get_nprocs_conf.h"],
    deps = [
        ":sys_sysinfo_get_nprocs",
        ":sys_sysinfo_get_nprocs_conf",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)

libc_support_library(
    name = "sys_sysinfo_get_nprocs",
    hdrs = ["get_nprocs.h"],
    deps = [
        "//libc/src/__support/macros:config",
    ],
)

libc_support_library(
    name = "sys_sysinfo_get_nprocs_conf",
    hdrs = ["get_nprocs_conf.h"],
    deps = [
        "//libc/src/__support/macros:config",
    ],
)
