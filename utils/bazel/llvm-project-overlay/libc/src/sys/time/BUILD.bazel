load("//libc:libc_build_rules.bzl", "libc_function", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "settimeofday",
    srcs = ["linux/settimeofday.cpp"],
    hdrs = ["settimeofday.h"],
    deps = [
        "//libc/hdr/types:struct_timespec",
        "//libc/hdr/types:struct_timeval",
        "//libc/hdr/types:struct_timezone",
        "//libc/hdr:errno_macros",
        "//libc/hdr:time_macros",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/time:clock_settime",
        "//libc/src/__support/time:units",
        "//libc/src/__support:common",
        "//libc/src/__support:error_or",
        "//libc/src/__support:libc_errno",
        "//libc/src/errno:errno",
    ],
)

libc_function(
    name = "futimes",
    srcs = ["linux/futimes.cpp"],
    hdrs = ["futimes.h"],
    deps = [
        ":sys_time_futimes",
        "//libc/hdr/types:struct_timespec",
        "//libc/hdr/types:struct_timeval",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:utimensat",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:libc_errno",
    ],
)

libc_function(
    name = "lutimes",
    srcs = ["linux/lutimes.cpp"],
    hdrs = ["lutimes.h"],
    deps = [
        ":sys_time_lutimes",
        "//libc/hdr/types:struct_timespec",
        "//libc/hdr/types:struct_timeval",
        "//libc/hdr:fcntl_macros",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:utimensat",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:libc_errno",
    ],
)

libc_support_library(
    name = "sys_time_lutimes",
    hdrs = ["lutimes.h"],
    deps = [
        "//libc/hdr/types:struct_timeval",
        "//libc/src/__support/macros:config",
    ],
)

libc_support_library(
    name = "sys_time_futimes",
    hdrs = ["futimes.h"],
    deps = [
        "//libc/hdr/types:struct_timeval",
        "//libc/src/__support/macros:config",
    ],
)

libc_function(
    name = "gettimeofday",
    srcs = ["linux/gettimeofday.cpp"],
    hdrs = ["gettimeofday.h"],
    deps = [
        "//libc/hdr/types:struct_timeval",
        "//libc/hdr/types:suseconds_t",
        "//libc/hdr:time_macros",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/time:clock_gettime",
        "//libc/src/__support/time:units",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/errno:errno",
    ],
)
