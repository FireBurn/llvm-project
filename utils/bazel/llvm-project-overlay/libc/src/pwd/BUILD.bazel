load("//libc:libc_build_rules.bzl", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_support_library(
    name = "pwd_utils",
    srcs = ["pwd_utils.cpp"],
    hdrs = ["pwd_utils.h"],
    deps = [
        "//libc/hdr/types:gid_t",
        "//libc/hdr/types:size_t",
        "//libc/hdr/types:struct_passwd",
        "//libc/hdr/types:uid_t",
        "//libc/hdr:errno_macros",
        "//libc/src/__support/CPP:span",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/File:line_reader",
        "//libc/src/__support/macros:attributes",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:ctype_utils",
        "//libc/src/__support:dynamic_buffer",
        "//libc/src/__support:error_or",
        "//libc/src/__support:pwd_field_tokenizer",
        "//libc/src/__support:pwd_flat_file_db",
        "//libc/src/__support:str_to_integer",
        "//libc/src/string:utils",
    ],
)
