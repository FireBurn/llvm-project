load("//libc:libc_build_rules.bzl", "libc_function", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_support_library(
    name = "unwind",
    hdrs = ["unwind.h"],
    deps = [
        "//libc/hdr:stdint_proxy",
        "//libc/src/__support/macros:config",
    ],
)

libc_support_library(
    name = "backtrace_line",
    hdrs = ["backtrace_line.h"],
    deps = [
        "//libc/hdr/types:size_t",
        "//libc/hdr:stdint_proxy",
        "//libc/src/__support/macros:attributes",
        "//libc/src/__support/macros:config",
    ],
)

libc_function(
    name = "backtrace",
    srcs = ["backtrace.cpp"],
    hdrs = ["backtrace.h"],
    deps = [
        ":unwind",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/threads:callonce",
        "//libc/src/__support:common",
        "//libc/src/dlfcn:dlopen",
        "//libc/src/dlfcn:dlsym",
    ],
)

libc_function(
    name = "backtrace_symbols_fd",
    srcs = ["backtrace_symbols_fd.cpp"],
    hdrs = ["backtrace_symbols_fd.h"],
    deps = [
        ":backtrace_line",
        "//libc/hdr/types:hdr_types_dl_info",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:write",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/dlfcn:dladdr",
    ],
)

libc_function(
    name = "backtrace_symbols",
    srcs = ["backtrace_symbols.cpp"],
    hdrs = ["backtrace_symbols.h"],
    deps = [
        ":backtrace_line",
        "//libc/hdr/func:malloc",
        "//libc/hdr/types:hdr_types_dl_info",
        "//libc/hdr/types:size_t",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/dlfcn:dladdr",
    ],
)
