load("//libc:libc_build_rules.bzl", "libc_function", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_support_library(
    name = "strfmon_impl",
    hdrs = ["strfmon_impl.h"],
    deps = [
        "//libc/hdr/types:size_t",
        "//libc/hdr/types:ssize_t",
        "//libc/hdr:errno_macros",
        "//libc/src/__support/CPP:limits",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:libc_errno",
        "//libc/src/locale:localeconv",
        "//libc/src/stdio:vsnprintf",
    ],
)

libc_function(
    name = "strfmon",
    srcs = ["strfmon.cpp"],
    hdrs = ["strfmon.h"],
    deps = [
        ":strfmon_impl",
        "//libc/hdr/types:locale_t",
        "//libc/hdr/types:size_t",
        "//libc/hdr/types:ssize_t",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)

libc_function(
    name = "strfmon_l",
    srcs = ["strfmon_l.cpp"],
    hdrs = ["strfmon_l.h"],
    deps = [
        ":strfmon_impl",
        "//libc/hdr/types:locale_t",
        "//libc/hdr/types:size_t",
        "//libc/hdr/types:ssize_t",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)
