load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "getnameinfo",
    srcs = ["getnameinfo.cpp"],
    hdrs = ["getnameinfo.h"],
    deps = [
        "//libc/hdr/types:socklen_t",
        "//libc/hdr/types:struct_sockaddr",
        "//libc/hdr/types:struct_sockaddr_in",
        "//libc/hdr/types:struct_sockaddr_in6",
        "//libc/hdr:net_if_macros",
        "//libc/hdr:netdb_macros",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/arpa/inet:inet_ntop",
        "//libc/src/arpa/inet:ntohs",
        "//libc/src/net:if_if_indextoname",
        "//libc/src/string/memory_utils:memory_utils",
        "//libc/src/string:utils",
    ],
)

libc_function(
    name = "__h_errno_location",
    srcs = ["__h_errno_location.cpp"],
    hdrs = ["__h_errno_location.h"],
    deps = [
        "//libc/src/__support/macros:attributes",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)
