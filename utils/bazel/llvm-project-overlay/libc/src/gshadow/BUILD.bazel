load("//libc:libc_build_rules.bzl", "libc_function", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_support_library(
    name = "gshadow_utils",
    srcs = ["gshadow_utils.cpp"],
    hdrs = ["gshadow_utils.h"],
    deps = [
        "//libc/hdr/types:struct_sgrp",
        "//libc/hdr:errno_macros",
        "//libc/src/__support/CPP:span",
        "//libc/src/__support/File:line_reader",
        "//libc/src/__support/macros:attributes",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:error_or",
        "//libc/src/__support:pwd_field_tokenizer",
        "//libc/src/__support:pwd_flat_file_db",
    ],
)

libc_support_library(
    name = "gshadow_r_utils",
    hdrs = ["gshadow_r_utils.h"],
    deps = [
        ":gshadow_utils",
        "//libc/hdr/types:size_t",
        "//libc/hdr/types:struct_sgrp",
        "//libc/hdr:errno_macros",
        "//libc/src/__support/CPP:span",
        "//libc/src/__support/File:line_reader",
        "//libc/src/__support/macros:attributes",
        "//libc/src/__support/macros:config",
    ],
)

