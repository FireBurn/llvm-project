load("//libc:libc_build_rules.bzl", "libc_function", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_support_library(
    name = "fnmatch_matcher",
    hdrs = ["fnmatch_matcher.h"],
    deps = [
        "//libc/hdr:fnmatch_macros",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/macros:attributes",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:ctype_utils",
    ],
)

libc_function(
    name = "fnmatch",
    srcs = ["fnmatch.cpp"],
    hdrs = ["fnmatch.h"],
    deps = [
        ":fnmatch_matcher",
        "//libc/hdr:fnmatch_macros",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)
