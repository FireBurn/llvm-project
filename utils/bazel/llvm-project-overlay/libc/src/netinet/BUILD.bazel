load("//libc:libc_build_rules.bzl", "libc_function", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_support_library(
    name = "ether_ethers",
    srcs = ["ether/ethers.cpp"],
    hdrs = ["ether/ethers.h"],
    deps = [
        "//libc/hdr/types:size_t",
        "//libc/hdr/types:struct_ether_addr",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:ctype_utils",
        "//libc/src/netdb:resolv_file_lines",
        "//libc/src/string/memory_utils:memory_utils",
    ],
)

libc_function(
    name = "ether_line",
    srcs = ["ether/ether_line.cpp"],
    hdrs = ["ether/ether_line.h"],
    deps = [
        ":ether_ethers",
        "//libc/hdr/types:size_t",
        "//libc/hdr/types:struct_ether_addr",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)

libc_function(
    name = "ether_ntohost",
    srcs = ["ether/ether_ntohost.cpp"],
    hdrs = ["ether/ether_ntohost.h"],
    deps = [
        ":ether_ethers",
        "//libc/hdr/types:size_t",
        "//libc/hdr/types:struct_ether_addr",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)

libc_function(
    name = "ether_hostton",
    srcs = ["ether/ether_hostton.cpp"],
    hdrs = ["ether/ether_hostton.h"],
    deps = [
        ":ether_ethers",
        "//libc/hdr/types:size_t",
        "//libc/hdr/types:struct_ether_addr",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)
