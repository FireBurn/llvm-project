load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "swapcontext",
    srcs = ["swapcontext.cpp"],
    hdrs = ["swapcontext.h"],
    full_build_only = True,
    deps = [
        ":getcontext",
        ":setcontext",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/errno:errno",
    ],
)

libc_function(
    name = "getcontext",
    srcs = select({
        "@platforms//cpu:aarch64": ["aarch64/getcontext.cpp"],
        "@platforms//cpu:riscv64": ["riscv/getcontext.cpp"],
        "@platforms//cpu:x86_64": ["x86_64/getcontext.cpp"],
        "//conditions:default": [],
    }),
    hdrs = ["getcontext.h"],
    full_build_only = True,
    deps = [
        "//libc/hdr/types:size_t",
        "//libc/include:llvm_libc_macros_signal_macros",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)

libc_function(
    name = "setcontext",
    srcs = select({
        "@platforms//cpu:aarch64": ["aarch64/setcontext.cpp"],
        "@platforms//cpu:riscv64": ["riscv/setcontext.cpp"],
        "@platforms//cpu:x86_64": ["x86_64/setcontext.cpp"],
        "//conditions:default": [],
    }),
    hdrs = ["setcontext.h"],
    full_build_only = True,
    deps = [
        "//libc/hdr/types:size_t",
        "//libc/include:llvm_libc_macros_signal_macros",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
    ],
)

libc_function(
    name = "makecontext",
    srcs = select({
        "@platforms//cpu:aarch64": ["aarch64/makecontext.cpp"],
        "@platforms//cpu:riscv64": ["riscv/makecontext.cpp"],
        "@platforms//cpu:x86_64": ["x86_64/makecontext.cpp"],
        "//conditions:default": [],
    }),
    hdrs = ["makecontext.h"],
    full_build_only = True,
    deps = [
        ":setcontext",
        "//libc/hdr:stdint_proxy",
        "//libc/src/__support/macros:config",
        "//libc/src/__support:common",
        "//libc/src/stdlib:exit",
    ],
)
